#!/usr/bin/env python3
#
# herdr-bellwethr — save, list, and delete herdr-plus projects.
#
#   herdr-bellwethr save                     save the current space, named after it
#   herdr-bellwethr save "Options Cafe"      save it under a different project name
#   herdr-bellwethr save --stdout            print the TOML instead of writing it
#   herdr-bellwethr list                     what is in the projects dir
#   herdr-bellwethr delete "Options Cafe"    remove one
#
#   herdr-bellwethr conventions              how this repo names branches
#   herdr-bellwethr dispatch "<task>" --branch feat/x    hand it to an agent
#   herdr-bellwethr runs                     what was dispatched, and how it went
#   herdr-bellwethr report <run> --file f    an agent recording how its own went
#   herdr-bellwethr reap                     worktrees that look finished with
#
# `save` snapshots the space you are looking at — tabs, panes, split directions,
# working dirs and the commands actually running — into one *.toml file in
# herdr-plus's projects/ dir, so `prefix+shift+o` can rebuild it later.
#
# `dispatch` is the other direction: a worktree, an agent started in it, and the
# task handed over once herdr reports the agent ready. It never invents a branch
# name — which names a repo accepts is the repo's business, so `conventions`
# reports the evidence and the caller chooses. `reap` clears up afterwards, and
# removes nothing until told to.
#
# `dispatch` also opens a run record and tells the agent, in the task itself, to
# close it with `report` — because the worktree, the workspace and the agent's
# pane are all things `reap` deletes, and everything the agent knew that is not
# in the diff goes with them. `runs` is the other half: which dispatches are
# still outstanding and what happened to the ones that finished, answered from
# disk without waiting on anybody. `reap` will not remove a worktree whose run
# was never reported.
#
# Reads live state over herdr's socket API (`herdr workspace|tab|pane ...`),
# never ~/.config/herdr/session.json — that file is a persistence detail and
# lags the running session.

"""Save, list, and delete herdr-plus project templates."""

import argparse
import json
import os
import os.path
import re
import shlex
import shutil
import subprocess
import sys
import time

# herdr-plus caps a tab at 4 panes (maxPanesPerTab in its project.go) and only
# understands these two split directions.
MAX_PANES_PER_TAB = 4
SPLIT_DOWN = "down"
SPLIT_RIGHT = "right"

# A pane sitting at its own prompt has no command worth recording. The pid test
# below catches the pane's login shell; this list catches a shell started
# *inside* it, which is just as uninteresting to replay.
SHELLS = {"sh", "bash", "zsh", "fish", "dash", "ksh", "tcsh", "csh", "nu", "elvish"}

# The plugin whose config dir holds projects/ — herdr-plus, not this one. The
# projects browser reads them, we write them, so the path has to be its dir.
PLUS_ID = "cloudmanic.herdr-plus"

# Ours, for run records. herdr provisions and keeps a config dir per plugin, and
# a run record is per-machine state about work done on this machine — the same
# category as saved projects and session state, which the README is clear the
# repository does not carry.
SELF_ID = "herdr-bellwethr"

PROG = "herdr-bellwethr"

# Set by --notify. Both the keybind and the quick-action launcher run this with
# no terminal anyone will read — the launcher's output goes to the picker pane
# herdr is about to tear down — so results have to reach the user through
# herdr's own notifications.
NOTIFY = False

# What a failure notification calls itself; main() names the subcommand.
FAIL_TITLE = "Herdr Plus: failed"


def notify(title, body):
    if not NOTIFY:
        return
    try:
        subprocess.run(
            ("herdr", "notification", "show", title, "--body", body, "--sound", "none"),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def die(msg):
    sys.stderr.write("%s: %s\n" % (PROG, msg))
    notify(FAIL_TITLE, msg)
    sys.exit(1)


def warn(msg):
    sys.stderr.write("%s: warning: %s\n" % (PROG, msg))


# ------------------------------------------------------------------ herdr ---

def herdr(*args):
    """Run a herdr CLI command and return its `result` object.

    The CLI reports failures in the JSON body and still exits 0, so the error
    key has to be checked explicitly — a plain returncode test would sail past
    'workspace not found' and hand back an empty snapshot.
    """
    try:
        proc = subprocess.run(
            ("herdr",) + args,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
    except FileNotFoundError:
        die("herdr is not on PATH")

    out = proc.stdout.decode("utf-8", "replace").strip()
    if proc.returncode != 0 and not out:
        err = proc.stderr.decode("utf-8", "replace").strip()
        die("herdr %s failed: %s" % (" ".join(args), err or "exit %d" % proc.returncode))

    try:
        payload = json.loads(out)
    except ValueError:
        die("herdr %s did not return JSON: %s" % (" ".join(args), out[:200]))

    if "error" in payload:
        e = payload["error"]
        die("herdr %s: %s (%s)" % (" ".join(args), e.get("message", "failed"), e.get("code", "?")))
    return payload.get("result", {})


def plugin_config_dir(plugin_id, fallback):
    """A plugin's config dir, asked of herdr rather than guessed.

    herdr provisions this directory and keeps it across plugin upgrades, so for
    herdr-plus it is the same path the projects browser reads, and for ours it
    is the one place a run record survives an upgrade of this plugin. Outside
    herdr a plugin falls back to ~/.config/<name>, and so do we.
    """
    try:
        proc = subprocess.run(
            ("herdr", "plugin", "config-dir", plugin_id),
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
    except FileNotFoundError:
        proc = None
    if proc is not None and proc.returncode == 0:
        path = proc.stdout.decode("utf-8", "replace").strip()
        if path and not path.startswith("{"):
            return path
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, fallback)


def projects_dir(override):
    if override:
        return os.path.expanduser(override)
    return os.path.join(plugin_config_dir(PLUS_ID, "herdr-plus"), "projects")


# --------------------------------------------------------------- inventory --

NAME_RE = re.compile(r'^\s*name\s*=\s*"((?:[^"\\]|\\.)*)"', re.MULTILINE)


def project_name(path):
    """The `name` a project file declares, or None if it declares none.

    tomllib is the authority where it exists (3.11+); the regex fallback only
    has to find one top-level string key, and stops at the first table so a
    [[tabs]] name is never mistaken for the project's.
    """
    try:
        with open(path, "rb") as handle:
            raw = handle.read()
    except OSError:
        return None

    try:
        import tomllib
        try:
            return (tomllib.loads(raw.decode("utf-8", "replace")).get("name") or "").strip() or None
        except tomllib.TOMLDecodeError:
            return None
    except ImportError:
        pass

    text = raw.decode("utf-8", "replace").split("\n[", 1)[0]
    match = NAME_RE.search(text)
    if not match:
        return None
    return match.group(1).replace('\\"', '"').replace("\\\\", "\\").strip() or None


def load_projects(directory):
    """Every saved project as (path, name), sorted by name."""
    try:
        entries = sorted(os.listdir(directory))
    except OSError:
        return []

    found = []
    for entry in entries:
        if not entry.endswith(".toml"):
            continue
        path = os.path.join(directory, entry)
        if os.path.isdir(path):
            continue
        found.append((path, project_name(path)))
    return sorted(found, key=lambda item: (item[1] or "").lower())


def free_path(directory, slug):
    """A file name no project is using yet.

    The file name is an implementation detail — herdr-plus identifies a project
    by its `name` — so a slug collision with an unrelated project is worked
    around rather than reported, and never overwrites that project.
    """
    path = os.path.join(directory, slug + ".toml")
    n = 2
    while os.path.exists(path):
        path = os.path.join(directory, "%s-%d.toml" % (slug, n))
        n += 1
    return path


def match_projects(projects, query):
    """Projects matching a name the user typed: exact first, then prefix.

    Matching is case-insensitive because that is how herdr-plus's own `open`
    resolves a name. The file's stem counts as a name too, so a project can be
    named the way its file is.
    """
    wanted = query.strip().lower()
    exact = [p for p in projects
             if (p[1] or "").lower() == wanted
             or os.path.splitext(os.path.basename(p[0]))[0].lower() == wanted]
    if exact:
        return exact
    return [p for p in projects if (p[1] or "").lower().startswith(wanted)]


def describe(projects):
    return ", ".join(p[1] or os.path.basename(p[0]) for p in projects)


# ------------------------------------------------------------------ picker --
#
# A fuzzy picker in the same spirit as herdr-plus's launcher: type to filter,
# arrows to move, enter to choose. herdr-plus gets its picker pane from the
# plugin system (see herdr-plugin.toml next to this script), which hands us a
# real terminal and tears the pane down when we exit — so all this has to do is
# draw on the tty it was given.

def fuzzy_score(text, query):
    """Rank a subsequence match, or None when the query does not fit.

    Lower is better. An earlier first hit and a tighter run of characters win,
    which is what makes typing "opt" land on "Options Cafe" ahead of a project
    that merely contains those letters far apart.
    """
    if not query:
        return (0, 0, len(text))

    haystack = text.lower()
    start = None
    gaps = 0
    position = 0
    for char in query.lower():
        found = haystack.find(char, position)
        if found < 0:
            return None
        if start is None:
            start = found
        else:
            gaps += found - position
        position = found + 1
    return (start, gaps, len(text))


def fuzzy_filter(projects, query):
    # No query, no ranking to do: keep the alphabetical order the list already
    # has, rather than shuffling it by whatever the tie-breaker happens to be.
    if not query:
        return list(projects)

    ranked = []
    for project in projects:
        label = project[1] or os.path.basename(project[0])
        score = fuzzy_score(label, query)
        if score is None:
            # Fall back to the file name so a project can be found by the file
            # it lives in, the same way `delete <name>` accepts a file stem.
            score = fuzzy_score(os.path.basename(project[0]), query)
            if score is None:
                continue
            score = (score[0] + 100,) + score[1:]
        ranked.append((score, project))
    ranked.sort(key=lambda item: item[0])
    return [project for _, project in ranked]


class Tty(object):
    """Raw-mode access to the controlling terminal.

    Reading /dev/tty rather than stdin keeps the picker working when output is
    piped, and raw mode is what makes single keystrokes arrive without Enter.
    """

    def __init__(self):
        self.handle = None
        self.saved = None

    def __enter__(self):
        import termios, tty
        self.handle = open("/dev/tty", "r+b", buffering=0)
        self.saved = termios.tcgetattr(self.handle.fileno())
        tty.setraw(self.handle.fileno())
        self.write("\033[?25l")           # hide the cursor while we paint
        return self

    def __exit__(self, *_):
        import termios
        self.write("\033[?25h\033[2J\033[H")
        termios.tcsetattr(self.handle.fileno(), termios.TCSADRAIN, self.saved)
        self.handle.close()

    def write(self, text):
        self.handle.write(text.encode("utf-8"))

    def key(self):
        """One keystroke: a character, or a name like 'up' / 'enter' / 'esc'.

        An escape byte is ambiguous — a bare Esc, or the start of an arrow
        sequence — so a short poll decides which. Without the timeout, Esc
        would hang until the next keypress.
        """
        import select
        first = self.handle.read(1)
        if not first:
            return "esc"
        if first == b"\x1b":
            ready, _, _ = select.select([self.handle], [], [], 0.05)
            if not ready:
                return "esc"
            rest = self.handle.read(1)
            if rest in (b"[", b"O"):
                final = self.handle.read(1)
                return {b"A": "up", b"B": "down"}.get(final, "")
            return ""
        if first in (b"\r", b"\n"):
            return "enter"
        if first in (b"\x7f", b"\x08"):
            return "backspace"
        if first == b"\x03":
            return "esc"
        if first == b"\x15":
            return "clear"
        if first == b"\x0e":
            return "down"
        if first == b"\x10":
            return "up"
        try:
            char = first.decode("utf-8")
        except UnicodeDecodeError:
            return ""
        return char if char.isprintable() else ""


def pick_project(projects, title):
    """Fuzzy-pick one project, or None if the user backed out."""
    query = ""
    selected = 0

    with Tty() as tty_io:
        while True:
            shown = fuzzy_filter(projects, query)
            if not shown:
                selected = 0
            else:
                selected = max(0, min(selected, len(shown) - 1))

            width = max([len(p[1] or "?") for p in projects] + [4])
            lines = ["\033[2J\033[H",
                     "  \033[1m%s\033[0m\r\n\r\n" % title,
                     "  > %s\033[7m \033[0m\r\n\r\n" % query]
            if not shown:
                lines.append("    \033[2mno project matches\033[0m\r\n")
            for i, (path, name) in enumerate(shown):
                label = name or "(unnamed)"
                if i == selected:
                    lines.append("  \033[32m❯\033[0m \033[1m%-*s\033[0m  \033[2m%s\033[0m\r\n"
                                 % (width, label, os.path.basename(path)))
                else:
                    lines.append("    %-*s  \033[2m%s\033[0m\r\n"
                                 % (width, label, os.path.basename(path)))
            lines.append("\r\n  \033[2mtype to filter · ↑/↓ move · enter select · esc cancel\033[0m\r\n")
            tty_io.write("".join(lines))

            key = tty_io.key()
            if key == "esc":
                return None
            if key == "enter":
                if not shown:
                    continue
                chosen = shown[selected]
                if confirm(tty_io, "delete %r?" % (chosen[1] or os.path.basename(chosen[0]))):
                    return chosen
                return None
            if key == "up":
                selected -= 1
            elif key == "down":
                selected += 1
            elif key == "backspace":
                query = query[:-1]
            elif key == "clear":
                query = ""
            elif key:
                query += key


def confirm(tty_io, question):
    """A y/N keystroke. Deleting is one keypress away, so it asks first."""
    tty_io.write("\r\n  %s \033[2m[y/N]\033[0m " % question)
    return tty_io.key().lower() == "y"


# --------------------------------------------------------------- processes --

def ancestor_pids():
    """Every pid between this process and init, for self-recognition.

    Whatever is running this script shows up as some pane's foreground process;
    without this the saved project would tell herdr to re-run the saver.
    """
    pids = set()
    pid = os.getpid()
    for _ in range(64):
        pids.add(pid)
        try:
            out = subprocess.run(
                ("ps", "-o", "ppid=", "-p", str(pid)),
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            ).stdout.decode().strip()
            parent = int(out.split()[0])
        except (ValueError, IndexError):
            break
        if parent <= 1 or parent in pids:
            break
        pid = parent
    return pids


def plugin_roots():
    """Install directories of every herdr plugin, for spotting plugin panes."""
    result = herdr("plugin", "list", "--json")
    roots = set()
    for plugin in result.get("plugins", []):
        for key in ("plugin_root", "manifest_path"):
            path = plugin.get(key)
            if key == "manifest_path" and path:
                path = os.path.dirname(path)
            if path:
                roots.add(os.path.normpath(path))
        source = plugin.get("source") or {}
        if source.get("managed_path"):
            roots.add(os.path.normpath(source["managed_path"]))
    return roots


def pane_process(pane_id):
    return herdr("pane", "process-info", "--pane", pane_id).get("process_info", {})


def is_plugin_pane(pane, info, roots):
    """True for a pane herdr opened to host plugin UI.

    The quick-action launcher and the projects browser run as herdr-managed
    panes, and while one is open it is a pane of the space like any other — so
    saving from the launcher would write the launcher itself into the project.
    They give themselves away by having no shell: the pane's root process *is*
    the plugin binary, run out of the plugin's install directory.
    """
    if not roots:
        return False
    shell_pid = info.get("shell_pid")
    for proc in info.get("foreground_processes", []):
        if proc.get("pid") != shell_pid:
            continue
        argv = proc.get("argv") or []
        if not argv:
            break
        exe = argv[0]
        cwd = proc.get("cwd") or ""
        if not os.path.isabs(exe):
            exe = os.path.normpath(os.path.join(cwd, exe))
        if any(exe == root or exe.startswith(root + os.sep) for root in roots):
            return True
        # Windows plugin panes go through powershell, so the binary is not
        # argv[0]; there the plugin root shows up as the pane's directory.
        if os.path.basename(argv[0]) not in SHELLS:
            cwd = os.path.normpath(cwd) if cwd else ""
            return any(cwd == root or cwd.startswith(root + os.sep) for root in roots)
        break
    return False


def pane_command(info, is_agent, ancestors):
    """The command to replay in this pane, or None for a plain shell.

    A pane's login shell is identified by pid, not by name: a pane running
    `bash -c ...` deliberately is worth keeping, an idle prompt is not.
    """
    shell_pid = info.get("shell_pid")
    for proc in info.get("foreground_processes", []):
        if proc.get("pid") == shell_pid:
            continue
        argv = proc.get("argv") or []
        if not argv:
            continue
        # Our own process tree, in a pane with no agent, is this script being
        # run from a shell — nothing to record. An agent pane is different:
        # `claude` is genuinely what that pane runs, even when it is the one
        # calling us.
        if proc.get("pid") in ancestors and not is_agent:
            return None
        if os.path.basename(argv[0]) in SHELLS:
            continue
        return " ".join(shlex.quote(a) for a in argv)
    return None


# ------------------------------------------------------------------ layout --

def split_tree(panes):
    """Rebuild a tab's split tree from pane geometry.

    herdr's layout response carries a flat `splits` list whose tree structure
    lives only in generated ids; the rectangles say the same thing without
    depending on that naming. Returns a leaf {'pane': p} or a node
    {'dir', 'first', 'second'}, or None if the panes do not tile cleanly.
    """
    if len(panes) == 1:
        return {"pane": panes[0]}

    def cut(axis, size, direction):
        edges = sorted({p["rect"][axis] for p in panes})
        for edge in edges[1:]:
            first = [p for p in panes if p["rect"][axis] < edge]
            second = [p for p in panes if p["rect"][axis] >= edge]
            if not first or not second:
                continue
            if all(p["rect"][axis] + p["rect"][size] <= edge for p in first):
                left, right = split_tree(first), split_tree(second)
                if left and right:
                    return {"dir": direction, "first": left, "second": right}
        return None

    # Try the side-by-side cut first; either one alone identifies the split.
    return cut("x", "width", SPLIT_RIGHT) or cut("y", "height", SPLIT_DOWN)


def prune_tree(node, drop):
    """Drop panes from a split tree, collapsing the splits they leave behind.

    Pruning the tree rather than the pane list keeps the surviving panes'
    geometry intact: a split with one child left simply becomes that child.
    """
    if node is None:
        return None
    if "pane" in node:
        return None if node["pane"]["pane_id"] in drop else node
    first = prune_tree(node["first"], drop)
    second = prune_tree(node["second"], drop)
    if first is None:
        return second
    if second is None:
        return first
    return {"dir": node["dir"], "first": first, "second": second}


def pane_chain(node):
    """Flatten a split tree into herdr-plus's linear pane list.

    A project builds panes in order, each one splitting off the *previous*
    pane, so the tree is reproduced exactly when every split's first side is a
    single pane. Anything else (a stacked pair beside a third pane, say) is
    flattened to the nearest chain and reported as approximate.
    """
    if "pane" in node:
        return [(node["pane"], None)], True

    first, first_exact = pane_chain(node["first"])
    second, second_exact = pane_chain(node["second"])
    head, _ = second[0]
    second = [(head, node["dir"])] + second[1:]
    exact = first_exact and second_exact and "pane" in node["first"]
    return first + second, exact


# -------------------------------------------------------------------- toml --

def toml_string(value):
    out = value.replace("\\", "\\\\").replace('"', '\\"')
    out = out.replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
    return '"%s"' % out


def tilde(path, home):
    if home and (path == home or path.startswith(home + os.sep)):
        return "~" + path[len(home):]
    return path


def shell_path(path, home):
    """Quote a path for a shell command, keeping ~ expandable.

    `cd '~/src'` would try to enter a directory literally named ~, so the tilde
    has to stay outside the quotes: `cd ~/'src'`. Keeping it (rather than
    writing the absolute path) is what lets the saved project open on another
    machine with a different home.
    """
    short = tilde(path, home)
    if short == "~":
        return "~"
    if short.startswith("~/"):
        return "~/" + shlex.quote(short[2:])
    return shlex.quote(short)


def slugify(name):
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    return slug or "space"


# ----------------------------------------------------------------- capture --

def resolve_space(requested):
    """Pick the space to save: --space, else the caller's, else the focused one."""
    workspaces = herdr("workspace", "list").get("workspaces", [])
    if not workspaces:
        die("herdr reports no spaces")

    wanted = requested or os.environ.get("HERDR_PLUS_WORKSPACE_ID") \
        or os.environ.get("HERDR_WORKSPACE_ID")
    if wanted:
        for ws in workspaces:
            if ws["workspace_id"] == wanted:
                return ws
        if requested:
            # Allow --space to name a space the way the sidebar labels it.
            matches = [w for w in workspaces if w.get("label") == requested]
            if len(matches) == 1:
                return matches[0]
            if len(matches) > 1:
                die("more than one space is labeled %r; use its id" % requested)
            die("no space %r (have: %s)" % (
                requested, ", ".join("%s (%s)" % (w["workspace_id"], w.get("label", "")) for w in workspaces)))

    for ws in workspaces:
        if ws.get("focused"):
            return ws
    return workspaces[0]


def tab_name(tab, panes, commands):
    """A tab needs a name; herdr only has one when the user set one.

    An unnamed tab reports its display number as the label, which says nothing
    in a template, so fall back to what the tab actually contains.
    """
    label = (tab.get("label") or "").strip()
    if label and not label.isdigit():
        return label
    for pane in panes:
        if pane.get("agent"):
            return pane["agent"]
    for command in commands:
        if command:
            return os.path.basename(shlex.split(command)[0])
    return "terminal"


def capture(space, args):
    ws_id = space["workspace_id"]
    ancestors = ancestor_pids()
    roots = plugin_roots()
    home = os.path.expanduser("~")

    tabs = herdr("tab", "list", "--workspace", ws_id).get("tabs", [])
    if not tabs:
        die("space %s has no tabs" % ws_id)

    all_panes = herdr("pane", "list", "--workspace", ws_id).get("panes", [])
    by_tab = {}
    for pane in all_panes:
        by_tab.setdefault(pane["tab_id"], []).append(pane)

    captured = []
    for tab in tabs:
        panes = by_tab.get(tab["tab_id"], [])
        if not panes:
            warn("tab %s has no panes; skipped" % tab["tab_id"])
            continue

        processes = {p["pane_id"]: pane_process(p["pane_id"]) for p in panes}
        transient = {p["pane_id"] for p in panes
                     if is_plugin_pane(p, processes[p["pane_id"]], roots)}
        keep = [p for p in panes if p["pane_id"] not in transient]
        if not keep:
            # Nothing here but plugin UI — a picker in a tab of its own is not
            # something a template should rebuild.
            continue

        layout = herdr("pane", "layout", "--pane", panes[0]["pane_id"]).get("layout", {})
        geometry = {p["pane_id"]: p for p in layout.get("panes", [])}
        placed = [geometry[p["pane_id"]] for p in panes if p["pane_id"] in geometry]

        if len(placed) != len(panes):
            warn("tab %s: layout is missing pane geometry; keeping pane order" % tab["tab_id"])
            chain = [(p["pane_id"], None if i == 0 else SPLIT_DOWN)
                     for i, p in enumerate(keep)]
        else:
            # The tree is built from every pane, including the transient ones,
            # so the geometry still tiles; they are pruned out afterwards.
            tree = prune_tree(split_tree(placed), transient)
            if tree is None:
                warn("tab %s: could not read the split layout; stacking panes" % tab["tab_id"])
                chain = [(p["pane_id"], None if i == 0 else SPLIT_DOWN)
                         for i, p in enumerate(keep)]
            else:
                ordered, exact = pane_chain(tree)
                if not exact:
                    warn("tab %s: nested splits flattened — herdr-plus builds each pane "
                         "off the previous one, so the rebuilt layout is close, not identical"
                         % tab["tab_id"])
                chain = [(p["pane_id"], d) for p, d in ordered]

        for split in layout.get("splits", []):
            ratio = split.get("ratio", 0.5)
            if abs(ratio - 0.5) > 0.05:
                warn("tab %s: split ratio %.2f is not part of the project format; "
                     "panes rebuild evenly" % (tab["tab_id"], ratio))
                break

        info = {p["pane_id"]: p for p in panes}
        entries = []
        for pane_id, split in chain:
            pane = info[pane_id]
            command = pane_command(processes[pane_id], bool(pane.get("agent")), ancestors)
            entries.append({
                "command": command,
                "split": split,
                "label": (pane.get("label") or "").strip(),
                "cwd": pane.get("cwd") or "",
            })

        if len(entries) > MAX_PANES_PER_TAB:
            warn("tab %s has %d panes; herdr-plus allows %d, dropping the last %d"
                 % (tab["tab_id"], len(entries), MAX_PANES_PER_TAB,
                    len(entries) - MAX_PANES_PER_TAB))
            entries = entries[:MAX_PANES_PER_TAB]

        captured.append({
            "name": tab_name(tab, keep, [e["command"] for e in entries]),
            "panes": entries,
        })

    if not captured:
        die("space %s has nothing to save" % ws_id)

    working_dir = args.working_dir or captured[0]["panes"][0]["cwd"] or home

    # A project has one working_dir; herdr-plus has no per-pane cwd. Panes that
    # sit somewhere else get a `cd` in front of their command, which works
    # because herdr-plus types the command into the pane's shell — a bare `cd`
    # leaves an interactive shell in the right place.
    if not args.no_cd:
        for tab in captured:
            for entry in tab["panes"]:
                cwd = entry["cwd"]
                if not cwd or cwd == working_dir:
                    continue
                prefix = "cd %s" % shell_path(cwd, home)
                entry["command"] = ("%s && %s" % (prefix, entry["command"])
                                    if entry["command"] else prefix)

    return {
        "name": args.name or space.get("label") or ws_id,
        "description": args.description,
        "group": args.group,
        "working_dir": tilde(working_dir, home),
        "tabs": captured,
        "source": "%s (%s)" % (space.get("label") or ws_id, ws_id),
    }


def render(project):
    lines = [
        "# herdr-plus project saved from herdr space %s." % project["source"],
        "# Written by %s — a plain template, edit it freely." % PROG,
        "",
        "name = %s" % toml_string(project["name"]),
    ]
    if project["description"]:
        lines.append("description = %s" % toml_string(project["description"]))
    if project["group"]:
        lines.append("group = %s" % toml_string(project["group"]))
    lines.append("working_dir = %s" % toml_string(project["working_dir"]))

    for tab in project["tabs"]:
        panes = tab["panes"]
        lines += ["", "[[tabs]]", "name = %s" % toml_string(tab["name"])]

        # One pane is the single-command shorthand; a split tab must use
        # [[tabs.panes]], and setting both is a load-time error in herdr-plus.
        if len(panes) == 1:
            pane = panes[0]
            if pane["label"]:
                # A labeled pane needs a pane table even when it is alone: a
                # tab has no label field of its own.
                lines += ["", "[[tabs.panes]]", "label = %s" % toml_string(pane["label"])]
                if pane["command"]:
                    lines.append("command = %s" % toml_string(pane["command"]))
            elif pane["command"]:
                lines.append("command = %s" % toml_string(pane["command"]))
            else:
                lines.append("# no command — just an empty shell")
            continue

        for i, pane in enumerate(panes):
            lines += ["", "[[tabs.panes]]"]
            if pane["label"]:
                lines.append("label = %s" % toml_string(pane["label"]))
            if pane["command"]:
                lines.append("command = %s" % toml_string(pane["command"]))
            elif not pane["label"]:
                lines.append("# no command — just an empty shell")
            if i > 0:
                lines.append("split = %s" % toml_string(pane["split"] or SPLIT_DOWN))

    return "\n".join(lines) + "\n"


def check(text, path):
    """Parse what we just produced, so a bad file never reaches the browser.

    herdr-plus fails the *whole* projects load on one malformed file, which
    would take the user's other projects down with it.
    """
    try:
        import tomllib
    except ImportError:
        return
    try:
        tomllib.loads(text)
    except tomllib.TOMLDecodeError as exc:
        die("generated TOML for %s is invalid (%s) — please report this" % (path, exc))


# ------------------------------------------------------------- subcommands --

def cmd_save(args):
    space = resolve_space(args.space)
    project = capture(space, args)
    text = render(project)

    if args.stdout:
        check(text, "<stdout>")
        sys.stdout.write(text)
        return

    tabs = ", ".join("%s%s" % (t["name"], " x%d" % len(t["panes"]) if len(t["panes"]) > 1 else "")
                     for t in project["tabs"])

    if args.out:
        path = os.path.expanduser(args.out)
        replacing = os.path.exists(path)
        if replacing and not args.force:
            die("%s already exists (use --force to overwrite)" % path)
    else:
        directory = projects_dir(args.projects_dir)
        # herdr-plus identifies a project by its name — two files claiming one
        # name give you two identical-looking rows in the browser and make
        # `herdr-plus open <name>` a coin toss. So the name, not the file name,
        # is what has to be unique.
        clashes = [p for p in load_projects(directory)
                   if (p[1] or "").lower() == project["name"].strip().lower()]
        if clashes and not args.force:
            die("a project named %r already exists (%s) — choose another name, or "
                'overwrite it with --force (the "Plus: save project" action)'
                % (project["name"], os.path.basename(clashes[0][0])))
        if len(clashes) > 1:
            warn("%d files are named %r; overwriting %s and leaving the rest"
                 % (len(clashes), project["name"], os.path.basename(clashes[0][0])))
        replacing = bool(clashes)
        path = clashes[0][0] if clashes else free_path(directory, slugify(project["name"]))

    check(text, path)

    try:
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w") as handle:
            handle.write(text)
    except OSError as exc:
        die("could not write %s: %s" % (path, exc))

    verb = "overwrote" if replacing else "saved"
    print("%s %r -> %s" % (verb, project["name"], path))
    print("  %s" % tabs)
    notify("Herdr Plus: project %s" % ("overwritten" if replacing else "saved"),
           "%s — %s" % (project["name"], tabs))


def cmd_list(args):
    directory = projects_dir(args.projects_dir)
    projects = load_projects(directory)
    if not projects:
        print("no saved projects in %s" % directory)
        return
    width = max(len(p[1] or "?") for p in projects)
    for path, name in projects:
        print("  %-*s  %s" % (width, name or "(unnamed)", os.path.basename(path)))


def cmd_delete(args):
    directory = projects_dir(args.projects_dir)
    projects = load_projects(directory)
    if not projects:
        die("no saved projects in %s" % directory)

    if args.pick or not args.name:
        if not os.path.exists("/dev/tty"):
            die("--pick needs a terminal; pass a project name instead")
        try:
            chosen = pick_project(projects, "Delete a Herdr Plus project")
        except (OSError, ImportError) as exc:
            die("could not open the picker (%s); pass a project name instead" % exc)
        if chosen is None:
            print("cancelled")
            return
        matches = [chosen]
    else:
        # An empty name prefix-matches everything, and with a single saved
        # project that would silently delete it. A blank form is not a delete.
        if not args.name.strip():
            die("name a project to delete (saved: %s)" % describe(projects))

        matches = match_projects(projects, args.name)
        if not matches:
            die("no project matching %r (have: %s)" % (args.name, describe(projects)))
        if len(matches) > 1:
            die("%r matches more than one project (%s) — use the full name"
                % (args.name, describe(matches)))

    path, name = matches[0]
    try:
        os.remove(path)
    except OSError as exc:
        die("could not delete %s: %s" % (path, exc))

    label = name or os.path.basename(path)
    print("deleted %r (%s)" % (label, path))
    notify("Herdr Plus: project deleted", "%s — %s" % (label, os.path.basename(path)))


# ------------------------------------------------------------------- git ----

def git(repo, *args):
    """Run git in `repo`. Returns (returncode, stdout, stderr), never dies.

    Callers here care about the difference between "no" and "broken" often
    enough that raising on non-zero would cost more than it saves — a branch
    that is not merged and a repository that is not there both come back as a
    non-zero exit, and only one of them is worth stopping for.
    """
    try:
        proc = subprocess.run(
            ("git",) + args, cwd=repo,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
    except OSError as exc:
        return 1, "", str(exc)
    return (proc.returncode,
            proc.stdout.decode("utf-8", "replace").strip(),
            proc.stderr.decode("utf-8", "replace").strip())


def repo_root(path):
    code, out, _ = git(path, "rev-parse", "--show-toplevel")
    if code != 0 or not out:
        die("not a git repository: %s" % path)
    return out


def hook_for(repo, name):
    """The hook script this repo would actually run, or None.

    core.hooksPath may be absent, relative or absolute, and a relative one is
    resolved against the working tree — which is why a worktree gets its own
    copy rather than the primary's.
    """
    code, configured, _ = git(repo, "config", "--get", "core.hooksPath")
    hooks_dir = configured if code == 0 and configured else ".git/hooks"
    if not os.path.isabs(hooks_dir):
        hooks_dir = os.path.join(repo, hooks_dir)
    path = os.path.join(hooks_dir, name)
    return path if os.access(path, os.X_OK) else None


# -------------------------------------------------------------- conventions --

def convention_evidence(repo):
    """What a caller needs to pick a branch name this repo will accept.

    Evidence, not rules. Nothing here encodes an opinion about naming — the
    repo's own history and its own hooks are the authority, and a repo with
    neither has no convention to violate.
    """
    _, subjects, _ = git(repo, "log", "--format=%s", "-n", "15")
    _, branches, _ = git(
        repo, "for-each-ref", "--format=%(refname:short)",
        "--sort=-committerdate", "--count=15", "refs/heads", "refs/remotes")

    hooks = {}
    for name in ("pre-commit", "commit-msg", "pre-push", "prepare-commit-msg"):
        found = hook_for(repo, name)
        if found:
            hooks[name] = found

    docs = [
        name for name in (
            "CONTRIBUTING.md", "AGENTS.md", "CLAUDE.md", "CONVENTIONS.md",
            os.path.join(".github", "PULL_REQUEST_TEMPLATE.md"),
        )
        if os.path.exists(os.path.join(repo, name))
    ]

    return {
        "repo": repo,
        "commit_subjects": [s for s in subjects.splitlines() if s],
        "branches": [b for b in branches.splitlines() if b],
        "hooks": hooks,
        "convention_docs": docs,
    }


def cmd_conventions(args):
    repo = repo_root(os.path.abspath(os.path.expanduser(args.repo or os.getcwd())))
    evidence = convention_evidence(repo)

    if args.json:
        print(json.dumps(evidence, indent=2, sort_keys=True))
        return

    print("repo: %s" % evidence["repo"])
    print("")
    print("recent commit subjects:")
    for subject in evidence["commit_subjects"]:
        print("  %s" % subject)
    print("")
    print("recent branches:")
    for branch in evidence["branches"]:
        print("  %s" % branch)
    print("")
    if evidence["hooks"]:
        print("hooks that will run (these are the authority, not the list above):")
        for name in sorted(evidence["hooks"]):
            print("  %-18s %s" % (name, evidence["hooks"][name]))
    else:
        print("hooks: none installed — nothing here enforces a naming convention")
    if evidence["convention_docs"]:
        print("")
        print("worth reading: %s" % ", ".join(evidence["convention_docs"]))


# -------------------------------------------------------------- run records --
#
# The only part of a dispatch that outlives it.
#
# `dispatch` hands a task to an agent in a worktree and returns. `reap` later
# removes that worktree, its workspace and the agent's pane together, and
# everything the agent knew that is not in the diff — what it decided and why,
# what it deliberately did not check, what it learned about the machine rather
# than the code — goes with them, silently. The dispatcher never finds out.
#
# So `dispatch` opens a record here and the agent closes it with `report`. The
# records live in this plugin's own config dir: herdr provisions it and keeps it
# across upgrades, and what accumulates in it is per-machine state, which is
# exactly the category the README says the repository deliberately leaves out.
#
# JSON, because both readers are as often agents as people, and because
# everything this script already exchanges with herdr is JSON. `runs <id>`
# renders a record as Markdown for a human and `report --comment` posts that
# same Markdown to the pull request — the record is for whoever dispatched the
# agent, the comment is for whoever reads the diff, and neither replaces the
# other: a pull request is closed and squashed away, a record is not.

RUNS_DIRNAME = "runs"

# Where the task tells the agent to draft its outcome. Named here rather than
# left to the agent because `reap` has to know to ignore it: a file this tool's
# own protocol asked for must not read as somebody mid-edit, for exactly the
# reason the task file must not.
OUTCOME_DRAFT = ".bellwethr-outcome.json"

# Sortable on purpose. An orchestrator with six finished runs wants to know
# which one to read first, and prose in this field cannot answer that — so the
# doubt itself goes in needs_decision and this stays one of three words.
CONFIDENCE = ("high", "medium", "low")

# What an agent is asked for, in the order it is asked and rendered. The
# template `report --template` prints is generated from this, so the questions
# an agent answers cannot drift from the fields a record holds.
#
# The list is short on purpose: every field is something a reaped worktree took
# with it and the diff could not give back. Nothing is here for completeness.
OUTCOME_FIELDS = (
    ("summary", "text", "What you did, in a few sentences."),
    ("not_done", "list", "What you deliberately did not do, and what you did not check."),
    ("decisions", "list", "What you decided and why — the why is the half the diff loses."),
    ("review_first", "list", "What a reviewer should look at first, and what to look for."),
    ("learned", "list", "What you learned that does not belong in the repository."),
    ("needs_decision", "list", "Anything now waiting on somebody else to decide."),
    ("confidence", "text", "How sure you are of the work: high, medium or low."),
    ("pr", "text", "The pull request, if you opened one. Found with gh if you omit it."),
)

OUTCOME_HEADINGS = {
    "not_done": "Not done, not checked",
    "decisions": "Decisions",
    "review_first": "Look at this first",
    "learned": "Learned",
    "needs_decision": "Needs a decision",
}


def now_stamp():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def runs_dir(override):
    if override:
        return os.path.expanduser(override)
    return os.path.join(plugin_config_dir(SELF_ID, SELF_ID), RUNS_DIRNAME)


def read_run(path):
    """One record, or None if it is unreadable or is not one of ours.

    Unreadable is treated as absent rather than fatal. These files are read by
    `reap` in one worktree while an agent may be writing one from another, and a
    directory somebody dropped a stray file into is not a reason to refuse to
    reap anything at all.
    """
    try:
        with open(path) as handle:
            record = json.load(handle)
    except (OSError, ValueError):
        return None
    if not isinstance(record, dict) or not record.get("branch"):
        return None
    return record


def load_runs(directory):
    """Every record as (path, record), newest dispatch first."""
    try:
        entries = sorted(os.listdir(directory))
    except OSError:
        return []

    found = []
    for entry in entries:
        if not entry.endswith(".json"):
            continue
        path = os.path.join(directory, entry)
        record = read_run(path)
        if record is not None:
            found.append((path, record))
    return sorted(found, key=lambda item: item[1].get("dispatched_at") or "", reverse=True)


def write_run(path, record):
    """Write a record. Returns "" or the reason it could not be written.

    Through a temporary file in the same directory, then renamed: a record is
    read by other processes, read_run treats a half-written one as no record at
    all, and for `reap` that is the difference between keeping a worktree and
    removing it.
    """
    tmp = "%s.%d.tmp" % (path, os.getpid())
    try:
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(tmp, "w") as handle:
            # ensure_ascii off: a record holds an agent's prose, and a human
            # reading the file should not have to decode \u2014 to read a dash.
            json.dump(record, handle, indent=2, sort_keys=True, ensure_ascii=False)
            handle.write("\n")
        os.replace(tmp, path)
    except OSError as exc:
        try:
            os.remove(tmp)
        except OSError:
            pass
        return str(exc)
    return ""


def remove_run(path):
    """Drop a record for a dispatch that was rolled back.

    Quiet about its own failure for the same reason teardown is: this runs while
    a different error is being reported, and a leftover record is a smaller
    problem than losing the message that explains what actually went wrong.
    """
    try:
        os.remove(path)
    except OSError:
        pass


def free_run_path(directory, slug):
    """A record file name nothing is using yet.

    A branch name is unique among live branches, which is what makes it a usable
    id — but branches are deleted and their names come back, and the record of
    what happened the first time is the thing least able to defend itself. A new
    dispatch never overwrites an old record.
    """
    path = os.path.join(directory, slug + ".json")
    n = 2
    while os.path.exists(path):
        path = os.path.join(directory, "%s-%d.json" % (slug, n))
        n += 1
    return path


def run_id(path):
    return os.path.splitext(os.path.basename(path))[0]


def match_runs(runs, wanted, cwd):
    """Records matching an id, a branch, or the checkout the caller stands in.

    Three ways in because the caller looking a run up is sometimes the
    dispatcher, which has the id, and sometimes the agent, which has no reason
    to have kept it but is standing in the checkout the record names.
    """
    if not wanted:
        here = os.path.realpath(cwd)
        return [(p, r) for p, r in runs
                if r.get("checkout") and os.path.realpath(r["checkout"]) == here]

    wanted = wanted.strip()
    exact = [(p, r) for p, r in runs
             if run_id(p) == wanted or r.get("branch") == wanted]
    if exact:
        return exact
    return [(p, r) for p, r in runs if run_id(p).startswith(wanted)]


def run_for(runs, path, branch):
    """The record describing a worktree, matched on its checkout then its branch.

    Checkout first and across every record before branch is tried at all: a
    branch checked out somewhere else is a weaker claim than a path, and the
    branch fallback is only there for a worktree that was moved.
    """
    here = os.path.realpath(path)
    for record_path, record in runs:
        checkout = record.get("checkout")
        if checkout and os.path.realpath(checkout) == here:
            return record_path, record
    if branch:
        for record_path, record in runs:
            if record.get("branch") == branch:
                return record_path, record
    return None


def run_state(record):
    if record.get("reaped_at"):
        return "reaped"
    if record.get("outcome"):
        return "reported"
    return "outstanding"


def describe_runs(runs, limit=6):
    names = [run_id(p) for p, _ in runs[:limit]]
    return ", ".join(names) + (", ..." if len(runs) > limit else "")


def agent_index():
    """Where each live agent is, indexed by pane id and by working directory.

    By pane first because that is the handle that survives a herdr restart — the
    alias `dispatch` reported does not, and `agent prompt <name>` answers
    agent_not_found once herdr has forgotten it. The cwd index is the fallback
    for a run whose agent came back in a different pane.
    """
    by_pane, by_cwd = {}, {}
    for agent in herdr_quiet("agent", "list")[0].get("agents", []):
        status = agent.get("agent_status") or "?"
        if agent.get("pane_id"):
            by_pane[agent["pane_id"]] = status
        if agent.get("cwd"):
            by_cwd[os.path.realpath(agent["cwd"])] = status
    return by_pane, by_cwd


def agent_state(record, by_pane, by_cwd):
    """What the dispatched agent is doing now, or "gone" if it is not there."""
    pane = record.get("pane")
    if pane and pane in by_pane:
        return by_pane[pane]
    checkout = record.get("checkout")
    if checkout:
        found = by_cwd.get(os.path.realpath(checkout))
        if found:
            return found
    return "gone"


def outcome_template():
    """The document `report` wants, with the questions still in it.

    Generated from OUTCOME_FIELDS. JSON has no comments, so each question is the
    placeholder value of the field that asks it — an agent that fills the
    template in has answered them in order, and one that leaves a question
    standing is caught by `report`, which refuses to record its own prompts as
    an outcome.
    """
    doc = {}
    for name, kind, question in OUTCOME_FIELDS:
        doc[name] = [question] if kind == "list" else question
    return json.dumps(doc, indent=2, sort_keys=True, ensure_ascii=False) + "\n"


def as_bullets(value):
    """A field's entries as strings, whatever shape they arrived in.

    A list is the documented shape; a single paragraph is what gets written when
    there is one thing to say, and refusing that would cost more than accepting
    it. A decision written as {"decision": ..., "why": ...} is joined rather
    than rejected for the same reason — the point is to keep what the agent
    said, not to win an argument about the schema.
    """
    if value is None or value == "":
        return []
    if isinstance(value, str):
        return [value.strip()] if value.strip() else []
    if isinstance(value, dict):
        value = [value]

    out = []
    for entry in value:
        if isinstance(entry, dict):
            parts = [str(entry[key]).strip()
                     for key in ("decision", "what", "why", "because", "detail")
                     if entry.get(key)]
            text = " — ".join(parts) or json.dumps(entry, sort_keys=True)
        else:
            text = str(entry).strip()
        if text:
            out.append(text)
    return out


def outcome_markdown(record):
    """A record's outcome as Markdown.

    One renderer for both audiences: the text `runs <id>` prints for a human is
    the text `report --comment` posts to the pull request. Two would drift, and
    the version the human read would be the one that was wrong.
    """
    outcome = record.get("outcome") or {}
    lines = ["## Outcome — %s" % (record.get("branch") or record.get("id") or "?"), ""]

    summary = (outcome.get("summary") or "").strip()
    if summary:
        lines += [summary, ""]
    if outcome.get("confidence"):
        lines += ["**Confidence:** %s" % outcome["confidence"], ""]

    for name, _, _ in OUTCOME_FIELDS:
        if name not in OUTCOME_HEADINGS:
            continue
        bullets = as_bullets(outcome.get(name))
        if not bullets:
            continue
        lines.append("### %s" % OUTCOME_HEADINGS[name])
        lines += ["- %s" % bullet.replace("\n", "\n  ") for bullet in bullets]
        lines.append("")

    # Read from git rather than reported: see landed_facts.
    commits = outcome.get("commits") or []
    if commits or outcome.get("diffstat"):
        lines.append("### What landed")
        if outcome.get("diffstat"):
            lines.append("%s on `%s`." % (outcome["diffstat"], record.get("branch")))
            lines.append("")
        lines += ["- `%s`" % commit for commit in commits]
        lines.append("")

    known = set(name for name, _, _ in OUTCOME_FIELDS) | {
        "reported_at", "commits", "diffstat", "head"}
    extra = sorted(name for name in outcome if name not in known)
    if extra:
        # Something the agent had to say that there was no field for. Dropping
        # it silently is the exact failure this record exists to prevent.
        lines.append("### Also reported")
        for name in extra:
            for bullet in as_bullets(outcome[name]) or [json.dumps(outcome[name])]:
                lines.append("- **%s**: %s" % (name, bullet))
        lines.append("")

    lines += ["---", "", "Run `%s`, reported %s by `%s report`." % (
        record.get("id") or "?", outcome.get("reported_at") or "?", PROG)]
    return "\n".join(lines).rstrip() + "\n"


def landed_facts(record):
    """What the branch holds, read from git rather than taken on trust.

    The agent is the authority on why it did something and a poor one on what it
    committed. These are also read *now*, at report time: after `reap` the
    branch may be gone, and this record will be the only place they exist.
    """
    repo = record.get("repo")
    branch = record.get("branch")
    base = record.get("base") or "main"
    if not (repo and branch and os.path.isdir(repo)):
        return {}

    facts = {}
    code, head, _ = git(repo, "rev-parse", "--short", branch)
    if code == 0 and head:
        facts["head"] = head
    code, log, _ = git(repo, "log", "--oneline", "--no-decorate",
                       "%s..%s" % (base, branch))
    if code == 0:
        facts["commits"] = [line for line in log.splitlines() if line]
    # Three dots: what the branch added, not what the base did meanwhile.
    code, stat, _ = git(repo, "diff", "--shortstat", "%s...%s" % (base, branch))
    if code == 0 and stat:
        facts["diffstat"] = stat
    return facts


def gh_pr_url(repo, branch):
    """The pull request for a branch, if gh can see one.

    Best effort in every direction: no gh, no network, no remote and no pull
    request all come back the same way, and none of them is a reason to refuse a
    report. --pr says it outright when this cannot.
    """
    if not shutil.which("gh"):
        return ""
    try:
        proc = subprocess.run(
            ("gh", "pr", "view", branch, "--json", "url", "--jq", ".url"),
            cwd=repo, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.decode("utf-8", "replace").strip()


def post_pr_comment(repo, branch, body):
    """Post an outcome to the branch's pull request. Returns "" or why not.

    Never fatal. The record is already written by the time this runs, so a
    failure here loses a convenience and not the outcome — which is the whole
    reason the record is not the pull request comment.
    """
    if not shutil.which("gh"):
        return "gh is not on PATH"
    try:
        proc = subprocess.run(
            ("gh", "pr", "comment", branch, "--body-file", "-"),
            cwd=repo, input=body.encode("utf-8"),
            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as exc:
        return str(exc)
    if proc.returncode == 0:
        return ""
    err = proc.stderr.decode("utf-8", "replace").strip()
    return err.splitlines()[0] if err else "gh pr comment exited %d" % proc.returncode


def report_command():
    """How an agent in a worktree should invoke this script.

    `herdr-bellwethr` on PATH is the answer that stays true when this checkout
    moves, so it is preferred — but only after checking that the one on PATH
    understands `report` at all. On a machine whose PATH points at an older
    install, or at a primary checkout while this is still on a branch, an agent
    would otherwise be told to run a subcommand that does not exist yet.
    """
    found = shutil.which(PROG)
    if found:
        try:
            probe = subprocess.run(
                (found, "report", "--template"),
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if probe.returncode == 0:
                return PROG
        except OSError:
            pass
    return os.path.realpath(__file__)


# ----------------------------------------------------------------- dispatch --

# A herdr agent alias has to match this and be unique among *live* agents.
AGENT_NAME_RE = re.compile(r"^[a-z][a-z0-9_-]*$")

DEFAULT_TASK_FILE = "TASK.md"


def agent_alias(branch, taken):
    """A herdr agent name derived from the branch, distinct from the live ones."""
    base = re.sub(r"[^a-z0-9]+", "-", branch.lower()).strip("-") or "agent"
    if not base[0].isalpha():
        base = "a" + base
    name = base[:40]
    n = 2
    while name in taken:
        name = "%s-%d" % (base[:36], n)
        n += 1
    return name


def live_agent_names():
    return set(a.get("name") or a.get("agent_name") or ""
               for a in herdr("agent", "list").get("agents", []))


def start_agent(alias, kind, pane_id, timeout_ms):
    """Start the agent, waiting out a pane that is not a shell prompt yet.

    A pane herdr has just built is not immediately somewhere an agent can be
    started in: the shell has to reach its prompt first, and until it does
    `agent start` refuses with agent_pane_busy. Its own --timeout does not cover
    this — that waits for the *agent* to become ready once it has been launched,
    which is a later problem than getting to launch it at all.

    So the wait is here, and it is a retry of the real call rather than a poll of
    something adjacent: herdr already knows what "an available shell" means, and
    a readiness test written here would be a second opinion that can disagree.
    """
    deadline = time.monotonic() + max(timeout_ms, 1000) / 1000.0
    while True:
        result, err = herdr_quiet(
            "agent", "start", alias, "--kind", kind,
            "--pane", pane_id, "--timeout", str(timeout_ms))
        if result or "agent_pane_busy" not in err:
            return result, err
        if time.monotonic() >= deadline:
            return {}, err + " — the pane never reached a shell prompt"
        time.sleep(0.5)


def probe_branch(checkout, branch):
    """Ask the repo's own pre-commit whether it will accept this branch name.

    Nothing is committed and nothing is staged: the hook is run for its opinion.
    Ours answers on the branch name alone, which is the case worth catching
    early — `worktree create` makes no commit, so without this the refusal lands
    at the agent's first commit, deep into its session and awkward to unwind.

    A hook that lints or runs tests may fail here for reasons that have nothing
    to do with the name, so this is advisory: the output goes back verbatim and
    the caller decides whether renaming is the answer. --no-probe skips it.
    """
    hook = hook_for(checkout, "pre-commit")
    if hook is None:
        return True, "no pre-commit hook in %s" % checkout

    try:
        proc = subprocess.run(
            (hook,), cwd=checkout,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        )
    except OSError as exc:
        return True, "could not run %s: %s" % (hook, exc)

    output = proc.stdout.decode("utf-8", "replace").strip()
    return proc.returncode == 0, output


def workspace_for_repo(repo):
    """An existing workspace whose panes sit in `repo`, or None.

    workspace list does not report a working directory — only panes do — so the
    mapping is built from the pane side.
    """
    prefix = os.path.realpath(repo) + os.sep
    for pane in herdr("pane", "list").get("panes", []):
        cwd = pane.get("cwd") or ""
        if cwd and (os.path.realpath(cwd) + os.sep).startswith(prefix):
            return pane.get("workspace_id")
    return None


def teardown(workspace_id, repo, branch, checkout):
    """Undo a dispatch that failed after it had already built something.

    Best effort and deliberately quiet about its own failures: this runs while
    reporting a different error, and a teardown problem must not replace the
    message explaining what actually went wrong.
    """
    if workspace_id:
        herdr_quiet("worktree", "remove", "--workspace", workspace_id)
        # Removing the worktree does not always take the workspace with it, and
        # a workspace left pointing at a deleted checkout is worse than the one
        # we were rolling back — it shows in the sidebar and cannot be reopened.
        herdr_quiet("workspace", "close", workspace_id)
    if checkout and os.path.isdir(checkout):
        git(repo, "worktree", "remove", "--force", checkout)
    git(repo, "worktree", "prune")
    if branch:
        git(repo, "branch", "-D", branch)


def herdr_quiet(*args):
    """herdr(), for calls whose failure is not worth dying over.

    Returns (result, error). The error half exists because herdr reports
    failures in the JSON body — a call that fails and a call that succeeds with
    nothing to say both leave an empty result, and telling the caller only that
    it "returned nothing" throws away the sentence explaining why.
    """
    try:
        proc = subprocess.run(
            ("herdr",) + args, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as exc:
        return {}, str(exc)

    # herdr answers on stdout when it succeeds and on stderr when it does not,
    # and both are JSON, so the body is worth parsing wherever it arrives.
    for stream in (proc.stdout, proc.stderr):
        text = stream.decode("utf-8", "replace").strip()
        if not text:
            continue
        try:
            payload = json.loads(text)
        except ValueError:
            continue
        if "error" in payload:
            e = payload["error"]
            return {}, "%s (%s)" % (e.get("message", "failed"), e.get("code", "?"))
        if "result" in payload:
            return payload["result"], ""

    text = proc.stderr.decode("utf-8", "replace").strip() \
        or proc.stdout.decode("utf-8", "replace").strip()
    return {}, text[:400] or "no output"


def fail(args, stage, message, detail=""):
    """Report a dispatch failure in a form a caller can act on.

    The orchestrator picking branch names is the audience for `stage` and
    `detail`: a refusal at the probe stage carries the hook's own words, which
    for a decent hook names the convention it wants.
    """
    if args.json:
        print(json.dumps({
            "ok": False, "stage": stage, "branch": args.branch,
            "message": message, "detail": detail,
        }, indent=2, sort_keys=True))
    else:
        sys.stderr.write("%s: %s: %s\n" % (PROG, stage, message))
        if detail:
            sys.stderr.write("\n%s\n" % detail)
    notify(FAIL_TITLE, message)
    sys.exit(1)


def task_document(args, repo, checkout, branch, workspace_id, pane_id, run=None):
    """The task, the facts about where it runs, and how to report back.

    Two sections after the task, and the difference between them is deliberate.

    The first is facts. An agent dropped into a fresh worktree has no way to
    know it is in one. It sees a checkout that looks like the repository and
    reasons about it as if it were — which is how a task written by somebody
    sitting in the primary checkout ends up asking for something only the
    primary checkout can do. The difference is not a matter of opinion, so it is
    stated rather than left to be discovered. What to *do* about it is not said:
    that belongs in the task, which is somebody else's to write.

    The second is an instruction, and unlike the first it is dispatch's own to
    give. Recording an outcome is not an opinion about the task; it is the
    protocol of the machinery the agent was started by, and the same machinery —
    `reap` — is what deletes the evidence when nobody records it. An agent that
    reports only when the dispatcher remembers to ask is precisely the situation
    this exists to end, so the asking is not left to the dispatcher.

    `run` is None when no record could be opened. The instruction is then left
    out rather than pointed at a run that does not exist: telling an agent to
    run a command that will fail is worse than telling it nothing.
    """
    if args.no_context:
        return args.task.rstrip("\n") + "\n"

    document = (
        "%s\n"
        "\n"
        "---\n"
        "\n"
        "## Where this is running\n"
        "\n"
        "Written by `%s dispatch`. You did not choose this checkout and it is\n"
        "not the one the task was written in.\n"
        "\n"
        "- This directory is a **linked git worktree**: `%s`\n"
        "- The primary checkout is elsewhere: `%s`\n"
        "- Branch `%s`, created from `%s`\n"
        "- herdr workspace `%s`, pane `%s`\n"
        "\n"
        "A worktree shares its history with the primary checkout and nothing\n"
        "else. Tooling that reaches outside the repository — installers, things\n"
        "that link or copy files into a live configuration — may refuse to run\n"
        "here, and refusing is usually the correct behaviour rather than a fault\n"
        "to work around. If the task asks for something that only the primary\n"
        "checkout can do, say so in the pull request instead of forcing it.\n"
        % (args.task.rstrip("\n"), PROG, checkout, repo, branch, args.base,
           workspace_id, pane_id)
    )

    if not run:
        return document

    return document + (
        "\n"
        "## Before you finish: record the outcome\n"
        "\n"
        "This task is run `%s`. Nothing but you will close it.\n"
        "\n"
        "`%s reap` removes this worktree, its workspace and this pane together\n"
        "once the work has landed. Everything you know that is not in the diff —\n"
        "what you decided and why, what you deliberately did not check, what you\n"
        "learned about this machine rather than about the code — goes with them,\n"
        "and whoever dispatched you never finds out any of it.\n"
        "\n"
        "So write it down before you stop:\n"
        "\n"
        "```sh\n"
        "%s report --template > %s   # the questions\n"
        "# answer them, then\n"
        "%s report %s --file %s\n"
        "```\n"
        "\n"
        "Add `--comment` to post the same text to the pull request in one step.\n"
        "The comment is for whoever reads the diff; the record is for whoever\n"
        "dispatched you, and it outlives the branch, the pull request and this\n"
        "checkout. Write both — they are read by different people at different\n"
        "times, and only one of them survives a squash merge.\n"
        "\n"
        "`reap` will not remove this worktree until that record has an outcome.\n"
        % (run["id"], PROG,
           run["command"], OUTCOME_DRAFT,
           run["command"], run["id"], OUTCOME_DRAFT)
    )


def cmd_dispatch(args):
    repo = repo_root(os.path.abspath(os.path.expanduser(args.repo or os.getcwd())))
    branch = args.branch.strip()

    if not branch or branch.startswith("-"):
        fail(args, "branch", "not a usable branch name: %r" % args.branch)

    code, _, _ = git(repo, "rev-parse", "--verify", "--quiet", "refs/heads/" + branch)
    if code == 0:
        fail(args, "branch", "branch %s already exists" % branch,
             "Pick another name, or check out the existing branch by hand.")

    created = herdr("worktree", "create",
                    "--cwd", repo, "--branch", branch, "--base", args.base,
                    "--label", args.label or branch,
                    "--focus" if args.focus else "--no-focus")

    workspace_id = (created.get("workspace") or {}).get("workspace_id")
    pane_id = (created.get("root_pane") or {}).get("pane_id")
    checkout = ((created.get("workspace") or {}).get("worktree") or {}).get("checkout_path") \
        or (created.get("root_pane") or {}).get("cwd")

    if not (workspace_id and pane_id and checkout):
        teardown(workspace_id, repo, branch, checkout)
        fail(args, "worktree", "herdr did not report a workspace, pane and checkout")

    if not args.no_probe:
        ok, output = probe_branch(checkout, branch)
        if not ok:
            teardown(workspace_id, repo, branch, checkout)
            fail(args, "probe",
                 "the repo's pre-commit hook refused branch %s" % branch, output)

    # The record is opened before the task is written, because the task has to
    # name it, and writing it now is also what reserves the name against a
    # second dispatch running at the same moment. It is written again below,
    # once there is an agent to name in it.
    #
    # A record and the instruction to close it are opened together or not at
    # all. A record nobody was told about would have `reap` guarding a worktree
    # for an outcome that was never going to arrive — so --no-context, which
    # asks for the task and nothing else, opts out of both.
    #
    # A record that cannot be *written* is a warning, not a failure. The
    # worktree, the agent and the task are what a dispatch is for; a directory
    # this could not write to is a reason to say so loudly, not to throw all
    # three away.
    record_path, record = None, None
    if not args.no_context:
        directory = runs_dir(args.runs_dir)
        record_path = free_run_path(directory, slugify(branch))
        record = {
            "id": run_id(record_path),
            "dispatched_at": now_stamp(),
            "repo": repo,
            "branch": branch,
            "base": args.base,
            "checkout": checkout,
            "workspace": workspace_id,
            "pane": pane_id,
            "kind": args.kind,
            "agent": None,
            "task_file": os.path.join(checkout, args.task_file),
            # The task itself, because the copy in the worktree is the one
            # `reap` deletes, and an outcome whose question nobody can read
            # afterwards is half a record.
            "task": args.task.rstrip("\n"),
            "outcome": None,
            "reaped_at": None,
        }
        err = write_run(record_path, record)
        if err:
            warn("no run record for %s: %s — the agent will not be asked to "
                 "report, and reap will not know to keep this worktree"
                 % (branch, err))
            record_path, record = None, None

    task_path = os.path.join(checkout, args.task_file)
    try:
        with open(task_path, "w") as handle:
            handle.write(task_document(
                args, repo, checkout, branch, workspace_id, pane_id,
                run=None if record is None else {"id": record["id"],
                                                 "command": report_command()}))
    except OSError as exc:
        teardown(workspace_id, repo, branch, checkout)
        if record_path:
            remove_run(record_path)
        fail(args, "task", "could not write %s: %s" % (task_path, exc))

    alias = args.agent_name or agent_alias(branch, live_agent_names())
    if not AGENT_NAME_RE.match(alias):
        teardown(workspace_id, repo, branch, checkout)
        if record_path:
            remove_run(record_path)
        fail(args, "agent", "not a usable agent name: %r" % alias)

    start, err = start_agent(alias, args.kind, pane_id, args.agent_timeout)
    if not start:
        teardown(workspace_id, repo, branch, checkout)
        if record_path:
            remove_run(record_path)
        fail(args, "agent", "%s did not come up in the new pane" % args.kind,
             err or "herdr agent start said nothing. Try `herdr agent explain`.")

    if record_path:
        record["agent"] = alias
        err = write_run(record_path, record)
        if err:
            warn("run %s does not name its agent: %s" % (record["id"], err))

    prompt = args.prompt or (
        "Read %s in the repository root and start on it." % args.task_file)

    # Deliberately not torn down past this point. The agent is up and the task
    # file is written, so a prompt that fails to land is something to retry by
    # hand — throwing the worktree away would take the agent's session with it.
    submitted, prompt_err = herdr_quiet(
        "agent", "prompt", alias, prompt, "--wait",
        "--until", "working", "--timeout", str(args.prompt_timeout))

    result = {
        "ok": True,
        "branch": branch,
        "base": args.base,
        "checkout": checkout,
        "workspace": workspace_id,
        "pane": pane_id,
        "agent": alias,
        "kind": args.kind,
        "task_file": task_path,
        "prompted": bool(submitted),
        "prompt_error": prompt_err,
        "run": None if record is None else record["id"],
        "run_record": record_path,
    }

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print("dispatched %s to %s (%s)" % (branch, alias, args.kind))
        print("  checkout   %s" % checkout)
        print("  workspace  %s   pane %s" % (workspace_id, pane_id))
        # The name is the convenient handle and the pane is the durable one: a
        # herdr restart keeps the pane and its process but forgets the alias,
        # and `agent prompt <name>` then answers agent_not_found.
        print("  reach it   herdr agent prompt %s ...   (or %s, which survives "
              "a herdr restart)" % (alias, pane_id))
        print("  task       %s" % task_path)
        if record is not None:
            print("  run        %s   (%s runs %s, when it is done)"
                  % (record["id"], PROG, record["id"]))
        if not submitted:
            print("  ! the prompt did not land: %s" % (prompt_err or "no reason given"))
            print("    submit it with `herdr agent prompt %s ...`" % alias)

    notify("Herdr Bellwethr: dispatched", "%s → %s" % (branch, alias))


# ------------------------------------------------------------------- report --

def outcome_from(args):
    """The outcome to record: a document, some flags, or a document flags add to.

    stdin is only read when `--file -` asks for it. An agent runs this with no
    terminal attached often enough that guessing from isatty() would sooner or
    later hang a report forever waiting on a pipe nobody is writing to.
    """
    doc = {}
    if args.file:
        if args.file == "-":
            where, raw = "<stdin>", sys.stdin.read()
        else:
            where = os.path.expanduser(args.file)
            try:
                with open(where) as handle:
                    raw = handle.read()
            except OSError as exc:
                die("could not read %s: %s" % (where, exc))
        try:
            doc = json.loads(raw)
        except ValueError as exc:
            die("%s is not JSON (%s) — `%s report --template` prints the shape "
                "this wants" % (where, exc, PROG))
        if not isinstance(doc, dict):
            die("%s should hold one JSON object, as `%s report --template` prints"
                % (where, PROG))

    for name, value in (("summary", args.summary), ("confidence", args.confidence),
                        ("pr", args.pr)):
        if value:
            doc[name] = value

    # Flags add to a document rather than replacing it, so a template answered
    # in a file and a late thought passed on the command line both survive.
    for name, values in (("not_done", args.not_done), ("decisions", args.decision),
                         ("review_first", args.review_first),
                         ("learned", args.learned),
                         ("needs_decision", args.needs_decision)):
        if values:
            doc[name] = as_bullets(doc.get(name)) + list(values)
    return doc


def strip_placeholders(doc):
    """Drop anything left exactly as `--template` printed it, keep the rest.

    A question that was not answered is not an answer, and recording it would
    have `runs` read the prompt back to the dispatcher as though it were the
    report. Fields this script never asked for are kept: an outcome nobody
    thought to ask for is still an outcome, and dropping it quietly is the
    failure the whole record exists to prevent.
    """
    questions = dict((name, question) for name, _, question in OUTCOME_FIELDS)

    out = {}
    for name, kind, question in OUTCOME_FIELDS:
        value = doc.get(name)
        if kind == "list":
            kept = [b for b in as_bullets(value) if b != question]
            if kept:
                out[name] = kept
        elif isinstance(value, str):
            if value.strip() and value.strip() != question:
                out[name] = value.strip()
        elif value:
            out[name] = value

    for name, value in doc.items():
        if name not in questions and value:
            out[name] = value
    return out


def resolve_run(directory, wanted, cwd):
    """The one record a command was asked about, or a refusal explaining why not."""
    runs = load_runs(directory)
    if not runs:
        die("no run records in %s — either nothing was dispatched from this "
            "machine, or it was dispatched before records existed" % directory)

    matches = match_runs(runs, wanted, cwd)
    if not matches:
        if wanted:
            die("no run matching %r (have: %s)" % (wanted, describe_runs(runs)))
        die("no run was dispatched into %s — name one instead (have: %s)"
            % (cwd, describe_runs(runs)))
    if len(matches) > 1:
        die("%r matches %d runs (%s) — name one exactly"
            % (wanted, len(matches), describe_runs(matches)))
    return matches[0]


def cmd_report(args):
    if args.template:
        sys.stdout.write(outcome_template())
        return

    path, record = resolve_run(runs_dir(args.runs_dir), args.run, os.getcwd())
    outcome = strip_placeholders(outcome_from(args))

    if not outcome.get("summary"):
        die("a report needs at least a summary — `%s report --template` prints "
            "the questions, and every one of them is something the worktree "
            "takes with it when reap removes it" % PROG)

    confidence = str(outcome.get("confidence") or "").strip().lower()
    if confidence not in CONFIDENCE:
        die("confidence should be one of %s, not %r — it is meant to be sorted "
            "on, so what the doubt actually is belongs in needs_decision"
            % (", ".join(CONFIDENCE), outcome.get("confidence") or ""))
    outcome["confidence"] = confidence

    outcome["reported_at"] = now_stamp()
    outcome.update(landed_facts(record))
    if not outcome.get("pr"):
        found = gh_pr_url(record.get("repo") or os.getcwd(), record["branch"])
        if found:
            outcome["pr"] = found

    # Reporting twice is an agent correcting itself, which is allowed — but the
    # first answer is kept rather than overwritten. This record exists because
    # something was lost the last time nobody kept a copy.
    was = record.get("outcome")
    if was:
        record.setdefault("superseded", []).append(was)
    record["outcome"] = outcome
    err = write_run(path, record)
    if err:
        die("could not write %s: %s" % (path, err))

    comment_err = ""
    if args.comment:
        comment_err = post_pr_comment(record.get("repo") or os.getcwd(),
                                      record["branch"], outcome_markdown(record))

    if args.json:
        print(json.dumps({"ok": True, "run": record["id"], "record": path,
                          "replaced": bool(was), "commented": args.comment and not comment_err,
                          "comment_error": comment_err},
                         indent=2, sort_keys=True))
    else:
        print("%s run %s -> %s" % ("re-reported" if was else "reported",
                                   record["id"], path))
        if outcome.get("pr"):
            print("  pull request %s" % outcome["pr"])
        if args.comment:
            print("  comment      %s" % (comment_err or "posted"))
        print("")
        print("reap will remove %s now that this is recorded." % record["branch"])

    notify("Herdr Bellwethr: outcome recorded",
           "%s — confidence %s" % (record["branch"], confidence))


