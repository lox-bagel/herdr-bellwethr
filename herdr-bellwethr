def show_run(record, path, by_pane, by_cwd, want_task):
    live = agent_state(record, by_pane, by_cwd)
    print("run        %s" % record["id"])
    print("branch     %s   (from %s)" % (record["branch"], record.get("base")))
    print("repo       %s" % record.get("repo"))
    print("checkout   %s%s" % (record.get("checkout"),
                               "" if os.path.isdir(record.get("checkout") or "")
                               else "   (gone)"))
    print("agent      %s   pane %s   %s"
          % (record.get("agent") or "?", record.get("pane") or "?", live))
    print("dispatched %s" % record.get("dispatched_at"))
    print("state      %s%s" % (run_state(record),
                               "" if not record.get("reaped_at")
                               else " %s — %s" % (record["reaped_at"],
                                                  record.get("reaped_reason", ""))))
    print("record     %s" % path)
    print("")

    if want_task:
        print(record.get("task") or "(no task recorded)")
        print("")
        return

    if record.get("outcome"):
        sys.stdout.write(outcome_markdown(record))
        return

    print("No outcome recorded yet. The agent was asked to run:")
    print("")
    print("    %s report %s --file %s" % (PROG, record["id"], OUTCOME_DRAFT))
    print("")
    if live == "gone":
        print("Its agent is gone, so nobody is going to. Read the pull request,")
        print("then either record it yourself or reap with --allow-unreported.")
    else:
        # Waiting is the caller's to do, one target at a time and never here:
        # an orchestrator that blocks on one agent cannot run several, and
        # running several is the point of dispatching at all.
        print("It is %s. To be told when it stops, without blocking anything else:"
              % live)
        print("")
        print("    herdr agent wait %s --until idle --until done"
              % (record.get("pane") or record.get("agent")))
    print("")
    print("`%s runs --task %s` prints the task it was given." % (PROG, record["id"]))


def cmd_runs(args):
    directory = runs_dir(args.runs_dir)
    by_pane, by_cwd = agent_index()

    if args.run or args.task:
        path, record = resolve_run(directory, args.run, os.getcwd())
        if args.json:
            print(json.dumps({"id": record["id"], "record": path,
                              "state": run_state(record),
                              "agent_state": agent_state(record, by_pane, by_cwd),
                              "run": record},
                             indent=2, sort_keys=True))
            return
        show_run(record, path, by_pane, by_cwd, args.task)
        return

    runs = load_runs(directory)
    if args.repo:
        wanted = os.path.realpath(os.path.expanduser(args.repo))
        runs = [(p, r) for p, r in runs
                if os.path.realpath(r.get("repo") or "") == wanted]
    rows = []
    for path, record in runs:
        state = run_state(record)
        if args.outstanding and state != "outstanding":
            continue
        rows.append({
            "id": record["id"],
            "record": path,
            "branch": record.get("branch"),
            "repo": record.get("repo"),
            "pane": record.get("pane"),
            "agent": record.get("agent"),
            "state": state,
            "agent_state": agent_state(record, by_pane, by_cwd),
            "dispatched_at": record.get("dispatched_at"),
            "confidence": (record.get("outcome") or {}).get("confidence"),
            "pr": (record.get("outcome") or {}).get("pr"),
        })

    if args.json:
        print(json.dumps({"runs_dir": directory, "runs": rows},
                         indent=2, sort_keys=True))
        return

    if not rows:
        print("no runs in %s%s" % (directory,
                                   " that are still outstanding" if args.outstanding else ""))
        return

    width = max(len(row["id"]) for row in rows)
    for row in rows:
        note = row["state"]
        if row["state"] == "reported" and row["confidence"]:
            note = "reported, confidence %s" % row["confidence"]
        print("  %-*s  %-9s  %-11s  %s"
              % (width, row["id"], row["agent_state"], note, row["branch"]))

    outstanding = [row for row in rows if row["state"] == "outstanding"]
    print("")
    if outstanding:
        print("%d outstanding. Read one with `%s runs <id>`; it says how to wait "
              "for that one\nwithout waiting on the others."
              % (len(outstanding), PROG))
    else:
        print("nothing outstanding. `%s runs <id>` prints an outcome." % PROG)


# --------------------------------------------------------------------- reap --

def worktree_entries(repo):
    """This repo's linked worktrees, as (path, branch) — never the primary one."""
    _, out, _ = git(repo, "worktree", "list", "--porcelain")
    entries, current = [], {}
    for line in out.splitlines() + [""]:
        if not line:
            if current.get("worktree"):
                entries.append(current)
            current = {}
            continue
        key, _, value = line.partition(" ")
        current[key] = value

    primary = os.path.realpath(repo)
    out = []
    for entry in entries:
        path = os.path.realpath(entry.get("worktree", ""))
        if not path or path == primary:
            continue
        branch = entry.get("branch", "")
        out.append((path, branch[len("refs/heads/"):] if branch.startswith("refs/heads/") else ""))
    return out


# Reasons that mean the work reached somewhere other than the base branch, so
# a `git branch -d` refusal is git being literal rather than git being right.
LANDED_ELSEWHERE = (
    "its upstream branch is gone",
    "its commits are on another remote branch",
)


def is_dirty(path, task_file):
    """Uncommitted work, ignoring the files this tool's own protocol put there.

    Without this every dispatched worktree is dirty forever: `dispatch` writes
    the task into the checkout, the task asks the agent to draft its outcome
    beside it, nothing ever commits either, and the one signal that should mean
    "somebody is mid-edit here" would fire on all of them.
    """
    ours = (task_file, OUTCOME_DRAFT)
    code, out, _ = git(path, "status", "--porcelain")
    if code != 0:
        return None
    for line in out.splitlines():
        if line.startswith("??") and line[3:].strip() in ours:
            continue
        if line.strip():
            return True
    return False


def landed_on_another_remote_branch(repo, branch):
    """Whether this branch's commits turned up on some *other* remote branch.

    Pushing is not landing. `--contains` finds the branch's own upstream first
    of all, so an unqualified reading of it calls a branch finished the moment
    it is pushed — which is the moment the work starts being reviewed, with an
    agent still sitting in the worktree waiting to answer. Its own remote ref is
    the one piece of evidence that proves nothing, so it is excluded: by the
    configured upstream where there is one, and by name for a branch pushed
    without tracking.
    """
    code, remotes, _ = git(repo, "branch", "--remotes", "--contains", branch)
    if code != 0 or not remotes:
        return False

    _, upstream, _ = git(repo, "rev-parse", "--abbrev-ref",
                         "%s@{upstream}" % branch)
    upstream = upstream.strip()

    for line in remotes.splitlines():
        ref = line.strip().lstrip("* ").strip()
        if not ref or ref.startswith("origin/HEAD"):
            continue
        if ref == upstream or ref.endswith("/" + branch):
            continue
        return True
    return False


def landing_reason(repo, path, branch, base, workspaces, task_file):
    """Whether the work in this worktree has landed, as (landed, reason).

    Everything here is about the code. Whether anybody wrote down what the agent
    knew is a separate question, asked by reap_reason on top of this one.
    """
    if not branch:
        return False, "detached HEAD — nothing to judge it by"
    if branch == base:
        return False, "is the base branch"

    if not os.path.isdir(path):
        return True, "checkout is gone"

    dirty = is_dirty(path, task_file)
    if dirty is None:
        return False, "could not read its status"
    if dirty:
        return False, "has uncommitted changes"

    # A branch with nothing of its own is not finished work, it is work that has
    # not started. It also looks "merged" to every test below, since a branch at
    # the base commit is trivially an ancestor of it — so an agent still reading
    # its task would be reaped as done. Ask first.
    code, ahead, _ = git(repo, "rev-list", "--count", "%s..%s" % (base, branch))
    if code == 0 and ahead.strip() == "0":
        return False, "no commits of its own yet"

    code, unpushed, _ = git(path, "log", "--oneline", "@{upstream}..HEAD")
    upstream_gone = code != 0
    if not upstream_gone and unpushed:
        return False, "has commits that are not pushed"

    state = workspaces.get(os.path.realpath(path))
    if state in ("working", "blocked"):
        # blocked is an agent waiting on somebody, which is a conversation in
        # progress rather than a finished one. idle is not: an agent that has
        # finished its turn in a worktree whose work has landed is exactly what
        # this is here to clear up.
        return False, "an agent is %s in it" % state

    code, _, _ = git(repo, "merge-base", "--is-ancestor", branch, base)
    if code == 0:
        return True, "merged into %s" % base

    if landed_on_another_remote_branch(repo, branch):
        return True, "its commits are on another remote branch"

    if upstream_gone:
        code, tracked, _ = git(repo, "config", "--get", "branch.%s.remote" % branch)
        if code == 0 and tracked:
            return True, "its upstream branch is gone"

    return False, "not merged into %s and not on another remote branch" % base


def reap_reason(repo, path, branch, base, workspaces, task_file, runs, allow_unreported):
    """Why this worktree is or is not finished with, as (removable, reason).

    The bar for removing is deliberately higher than the bar for keeping. A
    worktree kept one day too long costs a directory; one removed a moment too
    early costs whatever was in it — and what is in it is not only the diff.

    So landing is necessary and no longer sufficient. Removing takes the
    worktree, the workspace and the agent's pane together, and everything the
    agent knew that it did not commit goes with them; a run record with no
    outcome is the evidence that nobody wrote any of it down. This refuses
    rather than warning, because a warning printed among things being removed
    only works when somebody happens to be reading, and depending on somebody
    happening to be there is the habit the record replaced.

    A worktree with no record at all is judged exactly as it was before. This
    can only refuse on evidence it has, and inventing a reason to keep every
    worktree that predates run records would be a different tool.
    """
    landed, reason = landing_reason(repo, path, branch, base, workspaces, task_file)
    if not landed or allow_unreported:
        return landed, reason
    # Nothing to protect: the checkout is already gone, and the record survives
    # it either way. Refusing here would leave the stale entry forever.
    if not os.path.isdir(path):
        return landed, reason

    found = run_for(runs, path, branch)
    if found is None or found[1].get("outcome") or found[1].get("reaped_at"):
        return True, reason
    return False, ("%s, but run %s has no outcome — read it with `%s runs %s`, "
                   "ask the agent for one, or pass --allow-unreported"
                   % (reason, run_id(found[0]), PROG, run_id(found[0])))


def stamp_reaped(runs, path, branch, reason):
    """Note on the record that the worktree it describes is gone.

    The record outlives the checkout, so it has to stop claiming a directory
    that is not there any more: `runs` reads this to tell a dispatcher whether
    there is still an agent that could be asked anything.
    """
    found = run_for(runs, path, branch)
    if found is None or found[1].get("reaped_at"):
        return
    record_path, record = found
    record["reaped_at"] = now_stamp()
    record["reaped_reason"] = reason
    err = write_run(record_path, record)
    if err:
        warn("run %s still claims %s: %s" % (run_id(record_path), path, err))


def cmd_reap(args):
    repo = repo_root(os.path.abspath(os.path.expanduser(args.repo or os.getcwd())))

    if not args.no_fetch:
        git(repo, "fetch", "--prune", "--quiet")

    # Which checkout a workspace is sitting in, so a busy agent is not evicted.
    workspaces = {}
    panes = herdr_quiet("pane", "list")[0].get("panes", [])
    states = {w.get("workspace_id"): w.get("agent_status")
              for w in herdr_quiet("workspace", "list")[0].get("workspaces", [])}
    for pane in panes:
        cwd = pane.get("cwd")
        if cwd:
            workspaces[os.path.realpath(cwd)] = states.get(pane.get("workspace_id"))

    workspace_of = {}
    for pane in panes:
        cwd = pane.get("cwd")
        if cwd:
            workspace_of.setdefault(os.path.realpath(cwd), pane.get("workspace_id"))

    runs = load_runs(runs_dir(args.runs_dir))

    here = os.path.realpath(os.getcwd())
    removable, kept = [], []

    for path, branch in worktree_entries(repo):
        if here == path or here.startswith(path + os.sep):
            kept.append((path, branch, "you are in it"))
            continue
        ok, reason = reap_reason(repo, path, branch, args.base, workspaces,
                                 args.task_file, runs, args.allow_unreported)
        (removable if ok else kept).append((path, branch, reason))

    def entry(path, branch, reason):
        found = run_for(runs, path, branch)
        return {"path": path, "branch": branch, "reason": reason,
                "run": None if found is None else run_id(found[0]),
                "reported": bool(found and found[1].get("outcome"))}

    if args.json:
        print(json.dumps({
            "repo": repo,
            "removable": [entry(p, b, r) for p, b, r in removable],
            "kept": [entry(p, b, r) for p, b, r in kept],
            "removed": bool(args.remove),
        }, indent=2, sort_keys=True))
    else:
        for path, branch, reason in removable:
            print("%s %s — %s" % ("removing" if args.remove else "would remove",
                                  branch or path, reason))
        for path, branch, reason in kept:
            print("  keeping  %s — %s" % (branch or path, reason))
        if not args.remove and removable:
            print("")
            print("nothing was removed. Pass --remove to act on the list above.")

    if not args.remove:
        return

    task_file = args.task_file
    for path, branch, reason in removable:
        workspace_id = workspace_of.get(path)
        if workspace_id:
            herdr_quiet("worktree", "remove", "--workspace", workspace_id)
            herdr_quiet("workspace", "close", workspace_id)
        if os.path.isdir(path):
            code, _, err = git(repo, "worktree", "remove", path)
            if code != 0:
                # git refuses to remove a worktree holding anything untracked,
                # and every dispatched worktree holds the task file dispatch
                # wrote there. reap_reason already decided nothing else is
                # uncommitted, so forcing removes only that file — but the
                # check is repeated here rather than assumed, because the
                # decision was made before anything below started running.
                if is_dirty(path, task_file) is False:
                    code, _, err = git(repo, "worktree", "remove", "--force", path)
                if code != 0:
                    warn("kept %s: %s" % (path, err.splitlines()[0] if err else "refused"))
                    continue
        git(repo, "worktree", "prune")
        stamp_reaped(runs, path, branch, reason)
        # -d, never -D by default: git refuses a branch whose commits would be
        # lost, which is the one judgement here worth deferring to git for.
        code, _, err = git(repo, "branch", "-d", branch)
        if code == 0:
            continue

        # A squash merge leaves the branch's own commits nowhere in the base, so
        # git calls it unmerged however thoroughly the work landed. That is the
        # normal case in a repo that squashes, and it is why --delete-branch
        # exists — but only where something other than the base branch says the
        # work arrived, never on the "merged into base" reading alone.
        landed = reason in LANDED_ELSEWHERE
        if args.delete_branch and landed:
            code, _, err = git(repo, "branch", "-D", branch)
            if code == 0:
                print("  deleted branch %s (%s)" % (branch, reason))
                continue

        warn("kept branch %s: %s%s" % (
            branch,
            err.splitlines()[0] if err else "refused",
            "" if args.delete_branch or not landed
            else " — pass --delete-branch to remove it anyway"))


# -------------------------------------------------------------------- main --

def main():
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Save, list, and delete herdr-plus project templates.",
    )
    subparsers = parser.add_subparsers(dest="command")

    def shared(sub):
        sub.add_argument("--projects-dir", metavar="DIR",
                         help="projects directory (default: herdr-plus's own)")
        sub.add_argument("--notify", action="store_true",
                         help="report the result as a herdr notification (for keybinds "
                              "and quick actions, which have no terminal to print to)")

    def runs_option(sub):
        sub.add_argument("--runs-dir", metavar="DIR",
                         help="run records directory (default: this plugin's own "
                              "config dir, which herdr keeps across upgrades)")

    save = subparsers.add_parser(
        "save", help="save a space as a project",
        description="Save a live herdr space as a herdr-plus project template.",
        epilog="With no options it saves the space you are in, named after it. Reopen it "
               "from the projects browser (prefix+shift+o) or with `herdr-plus open <name>`.")
    save.add_argument("name", nargs="?", help="project name (default: the space's label)")
    save.add_argument("--space", metavar="ID", help="space to save, by id or label "
                      "(default: the current space, else the focused one)")
    save.add_argument("--group", metavar="TEXT", help="group heading in the projects browser")
    save.add_argument("--description", metavar="TEXT", help="project description")
    save.add_argument("--working-dir", metavar="PATH",
                      help="project working_dir (default: the first pane's cwd)")
    save.add_argument("--out", metavar="FILE", help="write here instead of the projects dir")
    save.add_argument("--stdout", action="store_true", help="print the TOML, write nothing")
    save.add_argument("--force", action="store_true",
                      help="overwrite the project that already has this name")
    save.add_argument("--no-cd", action="store_true",
                      help="skip the `cd` prefix for panes outside working_dir")
    shared(save)
    save.set_defaults(func=cmd_save)

    listing = subparsers.add_parser("list", help="list saved projects",
                                    description="List the saved herdr-plus projects.")
    shared(listing)
    listing.set_defaults(func=cmd_list)

    delete = subparsers.add_parser(
        "delete", help="delete a saved project",
        description="Delete a saved herdr-plus project by name.",
        epilog="The name is matched case-insensitively, exactly or by prefix; a prefix "
               "that matches several projects is refused rather than guessed.")
    delete.add_argument("name", nargs="?", default="",
                        help="project name (or its file name); omit to fuzzy-pick one")
    delete.add_argument("--pick", action="store_true",
                        help="always show the fuzzy picker, ignoring any name given")
    shared(delete)
    delete.set_defaults(func=cmd_delete)

    conventions = subparsers.add_parser(
        "conventions", help="what a repo expects of a branch or commit name",
        description="Report the evidence for naming a branch in a repo.",
        epilog="Evidence, not rules: recent commits and branches, the hooks that will "
               "actually run, and any convention docs. Nothing here has an opinion.")
    conventions.add_argument("--repo", metavar="PATH", help="repository (default: cwd)")
    conventions.add_argument("--json", action="store_true", help="machine-readable")
    shared(conventions)
    conventions.set_defaults(func=cmd_conventions)

    dispatch = subparsers.add_parser(
        "dispatch", help="hand a task to an agent in a fresh worktree",
        description="Create a worktree, start an agent in it, and give it the task.",
        epilog="--branch is required and never derived: which names a repo accepts is "
               "the repo's business, so ask `conventions` first and let the caller "
               "choose. A branch the repo's pre-commit hook rejects is reported with "
               "that hook's own words, and everything created is torn down again. The "
               "agent's name is forgotten if herdr restarts, so hold on to the pane id "
               "it reports — that keeps working. Every dispatch opens a run record and "
               "tells the agent, in the task, to close it with `report`; ask `runs` what "
               "came back, and never wait here for it.")
    dispatch.add_argument("task", help="the task, written into the worktree for the agent")
    dispatch.add_argument("--branch", required=True, metavar="NAME",
                          help="branch to create (required; nothing here invents one)")
    dispatch.add_argument("--repo", metavar="PATH", help="repository (default: cwd)")
    dispatch.add_argument("--base", metavar="REF", default="main",
                          help="what to branch from (default: main)")
    dispatch.add_argument("--kind", metavar="KIND", default="claude",
                          help="agent kind herdr should start (default: claude)")
    dispatch.add_argument("--agent-name", metavar="NAME",
                          help="agent alias (default: derived from the branch)")
    dispatch.add_argument("--label", metavar="TEXT", help="workspace label (default: the branch)")
    dispatch.add_argument("--task-file", metavar="NAME", default=DEFAULT_TASK_FILE,
                          help="where to write the task (default: %s)" % DEFAULT_TASK_FILE)
    dispatch.add_argument("--prompt", metavar="TEXT",
                          help="what to say to the agent (default: read the task file)")
    dispatch.add_argument("--no-context", action="store_true",
                          help="write the task alone: no note saying which worktree "
                               "and branch it is running in, and no run record — an "
                               "agent that was never asked to report an outcome must "
                               "not leave reap waiting for one")
    dispatch.add_argument("--no-probe", action="store_true",
                          help="skip asking the repo's pre-commit about the branch name")
    dispatch.add_argument("--focus", action="store_true", help="focus the new workspace")
    dispatch.add_argument("--agent-timeout", type=int, default=60000, metavar="MS")
    dispatch.add_argument("--prompt-timeout", type=int, default=60000, metavar="MS")
    dispatch.add_argument("--json", action="store_true", help="machine-readable")
    runs_option(dispatch)
    shared(dispatch)
    dispatch.set_defaults(func=cmd_dispatch)

    report = subparsers.add_parser(
        "report", help="record how a dispatched run went",
        description="Record a dispatched agent's outcome, where it outlives the worktree.",
        epilog="Run by the agent, not by whoever dispatched it — `dispatch` writes the "
               "instruction into the task so it does not depend on anybody remembering "
               "to ask. Start with --template, answer the questions in it, and pass it "
               "back with --file. With no run named, the run dispatched into the current "
               "directory is the one meant. Until this is recorded, `reap` will not "
               "remove the worktree.")
    report.add_argument("run", nargs="?",
                        help="run id or branch (default: the run dispatched into cwd)")
    report.add_argument("--template", action="store_true",
                        help="print the document this wants, questions included, and stop")
    report.add_argument("--file", metavar="PATH",
                        help="read the outcome from this JSON file, or - for stdin")
    report.add_argument("--summary", metavar="TEXT", help="what you did")
    report.add_argument("--confidence", metavar="LEVEL",
                        help="how sure you are: %s" % ", ".join(CONFIDENCE))
    report.add_argument("--not-done", metavar="TEXT", action="append", default=[],
                        help="something you did not do or did not check (repeatable)")
    report.add_argument("--decision", metavar="TEXT", action="append", default=[],
                        help="something you decided, and why (repeatable)")
    report.add_argument("--review-first", metavar="TEXT", action="append", default=[],
                        help="what a reviewer should look at first (repeatable)")
    report.add_argument("--learned", metavar="TEXT", action="append", default=[],
                        help="something learned that does not belong in the repo (repeatable)")
    report.add_argument("--needs-decision", metavar="TEXT", action="append", default=[],
                        help="something waiting on somebody else (repeatable)")
    report.add_argument("--pr", metavar="URL",
                        help="the pull request (default: whatever gh can find)")
    report.add_argument("--comment", action="store_true",
                        help="also post the outcome to the pull request with gh")
    report.add_argument("--json", action="store_true", help="machine-readable")
    runs_option(report)
    shared(report)
    report.set_defaults(func=cmd_report)

    runs = subparsers.add_parser(
        "runs", help="what was dispatched, and how it went",
        description="List dispatched runs, or read one agent's recorded outcome.",
        epilog="Answered from disk and from one `herdr agent list`: it never waits for "
               "anything, because an orchestrator that blocks on one agent cannot run "
               "several. `runs <id>` on a run that has not reported prints the "
               "`herdr agent wait` line that watches that one agent alone.")
    runs.add_argument("run", nargs="?", help="run id or branch (default: list them all)")
    runs.add_argument("--outstanding", action="store_true",
                      help="only runs that have not reported an outcome")
    runs.add_argument("--task", action="store_true",
                      help="print the task a run was dispatched with, and nothing else")
    runs.add_argument("--repo", metavar="PATH", help="only runs dispatched from this repo")
    runs.add_argument("--json", action="store_true", help="machine-readable")
    runs_option(runs)
    shared(runs)
    runs.set_defaults(func=cmd_runs)

    reap = subparsers.add_parser(
        "reap", help="report worktrees that look finished with",
        description="Find dispatched worktrees whose work has landed.",
        epilog="Reports and removes nothing until --remove. A worktree kept a day too "
               "long costs a directory; one removed a moment too early costs whatever "
               "was in it, so anything uncertain is kept and said out loud. A worktree "
               "whose run never reported an outcome is kept for the same reason: "
               "removing it takes the agent's pane with it and whatever the agent knew "
               "goes unwritten. Read it with `runs`, or say --allow-unreported.")
    reap.add_argument("--repo", metavar="PATH", help="repository (default: cwd)")
    reap.add_argument("--base", metavar="REF", default="main",
                      help="branch work merges into (default: main)")
    reap.add_argument("--remove", action="store_true", help="actually remove them")
    reap.add_argument("--delete-branch", action="store_true",
                      help="also delete a branch git calls unmerged, when the work "
                           "landed somewhere other than the base (squash merges)")
    reap.add_argument("--task-file", metavar="NAME", default=DEFAULT_TASK_FILE,
                      help="task file dispatch writes, ignored when judging a "
                           "worktree dirty (default: %s)" % DEFAULT_TASK_FILE)
    reap.add_argument("--allow-unreported", action="store_true",
                      help="remove a worktree whose run recorded no outcome — for an "
                           "agent that died, or a run whose outcome is genuinely in "
                           "the diff and nowhere else")
    reap.add_argument("--no-fetch", action="store_true",
                      help="skip `git fetch --prune`, use cached remote refs")
    reap.add_argument("--json", action="store_true", help="machine-readable")
    runs_option(reap)
    shared(reap)
    reap.set_defaults(func=cmd_reap)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(2)

    global NOTIFY, FAIL_TITLE
    NOTIFY = args.notify
    FAIL_TITLE = "Herdr Plus: %s failed" % args.command

    args.func(args)


if __name__ == "__main__":
    main()
