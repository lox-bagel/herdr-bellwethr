#!/usr/bin/env python3
#
# herdr-bellwethr — save, list, and delete herdr-plus projects.
#
#   herdr-bellwethr save                     save the current space, named after it
#   herdr-bellwethr save "Options Cafe"      save it under a different project name
#   herdr-bellwethr save --stdout            print the TOML instead of writing it
#   herdr-bellwethr list                     what is in the projects dir
#   herdr-bellwethr delete "Options Cafe"    remove one
#
#   herdr-bellwethr conventions              how this repo names branches
#   herdr-bellwethr dispatch "<task>" --branch feat/x    hand it to an agent
#   herdr-bellwethr reap                     worktrees that look finished with
#
# Reads live state over herdr's socket API (`herdr workspace|tab|pane ...`),
# never ~/.config/herdr/session.json — that file is a persistence detail and
# lags the running session.

"""Save herdr-plus projects, and dispatch agents into worktrees."""

import argparse
import json
import os
import os.path
import re
import shlex
import subprocess
import sys
import time

# herdr-plus caps a tab at 4 panes (maxPanesPerTab in its project.go) and only
# understands these two split directions.
MAX_PANES_PER_TAB = 4
SPLIT_DOWN = "down"
SPLIT_RIGHT = "right"

# Catches a shell started *inside* a pane; the pid test below catches the
# pane's own login shell.
SHELLS = {"sh", "bash", "zsh", "fish", "dash", "ksh", "tcsh", "csh", "nu", "elvish"}

# herdr-plus, not this plugin: its config dir is where projects/ lives, and its
# browser is what reads them.
PLUS_ID = "cloudmanic.herdr-plus"

PROG = "herdr-bellwethr"

# Set by --notify. Keybinds and launcher actions have no terminal anyone will
# read, so results have to reach the user as herdr notifications instead.
NOTIFY = False

# main() replaces this with one naming the subcommand.
FAIL_TITLE = "Herdr Bellwethr: failed"


def notify(title, body):
    if not NOTIFY:
        return
    try:
        subprocess.run(
            ("herdr", "notification", "show", title, "--body", body, "--sound", "none"),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def die(msg):
    sys.stderr.write("%s: %s\n" % (PROG, msg))
    notify(FAIL_TITLE, msg)
    sys.exit(1)


def warn(msg):
    sys.stderr.write("%s: warning: %s\n" % (PROG, msg))


# ------------------------------------------------------------------ herdr ---

def herdr(*args):
    """Run a herdr CLI command and return its `result` object.

    The CLI reports failures in the JSON body and still exits 0, so a plain
    returncode test would sail past 'workspace not found' with an empty result.
    """
    try:
        proc = subprocess.run(
            ("herdr",) + args,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
    except FileNotFoundError:
        die("herdr is not on PATH")

    out = proc.stdout.decode("utf-8", "replace").strip()
    if proc.returncode != 0 and not out:
        err = proc.stderr.decode("utf-8", "replace").strip()
        die("herdr %s failed: %s" % (" ".join(args), err or "exit %d" % proc.returncode))

    try:
        payload = json.loads(out)
    except ValueError:
        die("herdr %s did not return JSON: %s" % (" ".join(args), out[:200]))

    if "error" in payload:
        e = payload["error"]
        die("herdr %s: %s (%s)" % (" ".join(args), e.get("message", "failed"), e.get("code", "?")))
    return payload.get("result", {})


def plugin_config_dir():
    """Where herdr-plus keeps projects/, asked of herdr rather than guessed.

    Outside herdr the plugin falls back to ~/.config/herdr-plus, and so do we.
    """
    try:
        proc = subprocess.run(
            ("herdr", "plugin", "config-dir", PLUS_ID),
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
    except FileNotFoundError:
        proc = None
    if proc is not None and proc.returncode == 0:
        path = proc.stdout.decode("utf-8", "replace").strip()
        if path and not path.startswith("{"):
            return path
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "herdr-plus")


def projects_dir(override):
    if override:
        return os.path.expanduser(override)
    return os.path.join(plugin_config_dir(), "projects")


# --------------------------------------------------------------- inventory --

NAME_RE = re.compile(r'^\s*name\s*=\s*"((?:[^"\\]|\\.)*)"', re.MULTILINE)


def project_name(path):
    """The `name` a project file declares, or None if it declares none.

    The pre-3.11 regex fallback stops at the first table, so a [[tabs]] name is
    never mistaken for the project's.
    """
    try:
        with open(path, "rb") as handle:
            raw = handle.read()
    except OSError:
        return None

    try:
        import tomllib
        try:
            return (tomllib.loads(raw.decode("utf-8", "replace")).get("name") or "").strip() or None
        except tomllib.TOMLDecodeError:
            return None
    except ImportError:
        pass

    text = raw.decode("utf-8", "replace").split("\n[", 1)[0]
    match = NAME_RE.search(text)
    if not match:
        return None
    return match.group(1).replace('\\"', '"').replace("\\\\", "\\").strip() or None


def load_projects(directory):
    """Every saved project as (path, name), sorted by name."""
    try:
        entries = sorted(os.listdir(directory))
    except OSError:
        return []

    found = []
    for entry in entries:
        if not entry.endswith(".toml"):
            continue
        path = os.path.join(directory, entry)
        if os.path.isdir(path):
            continue
        found.append((path, project_name(path)))
    return sorted(found, key=lambda item: (item[1] or "").lower())


def free_path(directory, slug):
    """A file name no project is using yet.

    herdr-plus identifies a project by its `name`, so a slug collision is worked
    around rather than reported.
    """
    path = os.path.join(directory, slug + ".toml")
    n = 2
    while os.path.exists(path):
        path = os.path.join(directory, "%s-%d.toml" % (slug, n))
        n += 1
    return path


def match_projects(projects, query):
    """Projects matching a name the user typed: exact first, then prefix.

    Case-insensitive, matching herdr-plus's own `open`. A file stem counts too.
    """
    wanted = query.strip().lower()
    exact = [p for p in projects
             if (p[1] or "").lower() == wanted
             or os.path.splitext(os.path.basename(p[0]))[0].lower() == wanted]
    if exact:
        return exact
    return [p for p in projects if (p[1] or "").lower().startswith(wanted)]


def describe(projects):
    return ", ".join(p[1] or os.path.basename(p[0]) for p in projects)


# ------------------------------------------------------------------ picker --
#
# herdr-plugin.toml hands this a real terminal as a plugin pane and tears it
# down on exit, so all this has to do is draw on the tty it was given.

def fuzzy_score(text, query):
    """Rank a subsequence match, or None when the query does not fit.

    Lower is better: an earlier first hit and a tighter run of characters win.
    """
    if not query:
        return (0, 0, len(text))

    haystack = text.lower()
    start = None
    gaps = 0
    position = 0
    for char in query.lower():
        found = haystack.find(char, position)
        if found < 0:
            return None
        if start is None:
            start = found
        else:
            gaps += found - position
        position = found + 1
    return (start, gaps, len(text))


def fuzzy_filter(projects, query):
    # No query, no ranking: keep the alphabetical order the list already has.
    if not query:
        return list(projects)

    ranked = []
    for project in projects:
        label = project[1] or os.path.basename(project[0])
        score = fuzzy_score(label, query)
        if score is None:
            # Findable by file name too, as `delete <name>` allows.
            score = fuzzy_score(os.path.basename(project[0]), query)
            if score is None:
                continue
            score = (score[0] + 100,) + score[1:]
        ranked.append((score, project))
    ranked.sort(key=lambda item: item[0])
    return [project for _, project in ranked]


class Tty(object):
    """Raw-mode access to the controlling terminal.

    /dev/tty rather than stdin, so the picker still works when output is piped.
    """

    def __init__(self):
        self.handle = None
        self.saved = None

    def __enter__(self):
        import termios, tty
        self.handle = open("/dev/tty", "r+b", buffering=0)
        self.saved = termios.tcgetattr(self.handle.fileno())
        tty.setraw(self.handle.fileno())
        self.write("\033[?25l")           # hide the cursor while we paint
        return self

    def __exit__(self, *_):
        import termios
        self.write("\033[?25h\033[2J\033[H")
        termios.tcsetattr(self.handle.fileno(), termios.TCSADRAIN, self.saved)
        self.handle.close()

    def write(self, text):
        self.handle.write(text.encode("utf-8"))

    def key(self):
        """One keystroke: a character, or a name like 'up' / 'enter' / 'esc'.

        An escape byte is ambiguous — bare Esc, or the start of an arrow
        sequence — so a short poll decides which; without it Esc would hang.
        """
        import select
        first = self.handle.read(1)
        if not first:
            return "esc"
        if first == b"\x1b":
            ready, _, _ = select.select([self.handle], [], [], 0.05)
            if not ready:
                return "esc"
            rest = self.handle.read(1)
            if rest in (b"[", b"O"):
                final = self.handle.read(1)
                return {b"A": "up", b"B": "down"}.get(final, "")
            return ""
        if first in (b"\r", b"\n"):
            return "enter"
        if first in (b"\x7f", b"\x08"):
            return "backspace"
        if first == b"\x03":
            return "esc"
        if first == b"\x15":
            return "clear"
        if first == b"\x0e":
            return "down"
        if first == b"\x10":
            return "up"
        try:
            char = first.decode("utf-8")
        except UnicodeDecodeError:
            return ""
        return char if char.isprintable() else ""


def pick_project(projects, title):
    """Fuzzy-pick one project, or None if the user backed out."""
    query = ""
    selected = 0

    with Tty() as tty_io:
        while True:
            shown = fuzzy_filter(projects, query)
            if not shown:
                selected = 0
            else:
                selected = max(0, min(selected, len(shown) - 1))

            width = max([len(p[1] or "?") for p in projects] + [4])
            lines = ["\033[2J\033[H",
                     "  \033[1m%s\033[0m\r\n\r\n" % title,
                     "  > %s\033[7m \033[0m\r\n\r\n" % query]
            if not shown:
                lines.append("    \033[2mno project matches\033[0m\r\n")
            for i, (path, name) in enumerate(shown):
                label = name or "(unnamed)"
                if i == selected:
                    lines.append("  \033[32m❯\033[0m \033[1m%-*s\033[0m  \033[2m%s\033[0m\r\n"
                                 % (width, label, os.path.basename(path)))
                else:
                    lines.append("    %-*s  \033[2m%s\033[0m\r\n"
                                 % (width, label, os.path.basename(path)))
            lines.append("\r\n  \033[2mtype to filter · ↑/↓ move · enter select · esc cancel\033[0m\r\n")
            tty_io.write("".join(lines))

            key = tty_io.key()
            if key == "esc":
                return None
            if key == "enter":
                if not shown:
                    continue
                chosen = shown[selected]
                if confirm(tty_io, "delete %r?" % (chosen[1] or os.path.basename(chosen[0]))):
                    return chosen
                return None
            if key == "up":
                selected -= 1
            elif key == "down":
                selected += 1
            elif key == "backspace":
                query = query[:-1]
            elif key == "clear":
                query = ""
            elif key:
                query += key


def confirm(tty_io, question):
    """A y/N keystroke."""
    tty_io.write("\r\n  %s \033[2m[y/N]\033[0m " % question)
    return tty_io.key().lower() == "y"


# --------------------------------------------------------------- processes --

def ancestor_pids():
    """Every pid between this process and init.

    This script shows up as some pane's foreground process, and without
    recognising it the saved project would tell herdr to re-run the saver.
    """
    pids = set()
    pid = os.getpid()
    for _ in range(64):
        pids.add(pid)
        try:
            out = subprocess.run(
                ("ps", "-o", "ppid=", "-p", str(pid)),
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            ).stdout.decode().strip()
            parent = int(out.split()[0])
        except (ValueError, IndexError):
            break
        if parent <= 1 or parent in pids:
            break
        pid = parent
    return pids


def plugin_roots():
    """Install directories of every herdr plugin, for spotting plugin panes."""
    result = herdr("plugin", "list", "--json")
    roots = set()
    for plugin in result.get("plugins", []):
        for key in ("plugin_root", "manifest_path"):
            path = plugin.get(key)
            if key == "manifest_path" and path:
                path = os.path.dirname(path)
            if path:
                roots.add(os.path.normpath(path))
        source = plugin.get("source") or {}
        if source.get("managed_path"):
            roots.add(os.path.normpath(source["managed_path"]))
    return roots


def pane_process(pane_id):
    return herdr("pane", "process-info", "--pane", pane_id).get("process_info", {})


def is_plugin_pane(pane, info, roots):
    """True for a pane herdr opened to host plugin UI.

    Saving from the launcher would otherwise write the launcher into the
    project. Such panes have no shell: the root process *is* the plugin binary.
    """
    if not roots:
        return False
    shell_pid = info.get("shell_pid")
    for proc in info.get("foreground_processes", []):
        if proc.get("pid") != shell_pid:
            continue
        argv = proc.get("argv") or []
        if not argv:
            break
        exe = argv[0]
        cwd = proc.get("cwd") or ""
        if not os.path.isabs(exe):
            exe = os.path.normpath(os.path.join(cwd, exe))
        if any(exe == root or exe.startswith(root + os.sep) for root in roots):
            return True
        # Windows plugin panes go through powershell, so the binary is not
        # argv[0]; there the plugin root shows up as the pane's directory.
        if os.path.basename(argv[0]) not in SHELLS:
            cwd = os.path.normpath(cwd) if cwd else ""
            return any(cwd == root or cwd.startswith(root + os.sep) for root in roots)
        break
    return False


def pane_command(info, is_agent, ancestors):
    """The command to replay in this pane, or None for a plain shell.

    The login shell is identified by pid, not name: a pane deliberately running
    `bash -c ...` is worth keeping, an idle prompt is not.
    """
    shell_pid = info.get("shell_pid")
    for proc in info.get("foreground_processes", []):
        if proc.get("pid") == shell_pid:
            continue
        argv = proc.get("argv") or []
        if not argv:
            continue
        # Our own tree in a non-agent pane is this script, run from a shell.
        # An agent pane is different: `claude` is what that pane genuinely runs,
        # even when it is the one calling us.
        if proc.get("pid") in ancestors and not is_agent:
            return None
        if os.path.basename(argv[0]) in SHELLS:
            continue
        return " ".join(shlex.quote(a) for a in argv)
    return None


# ------------------------------------------------------------------ layout --

def split_tree(panes):
    """Rebuild a tab's split tree from pane geometry.

    herdr's flat `splits` list encodes its tree only in generated ids; the
    rectangles say the same thing without depending on that naming. Returns a
    leaf {'pane'} or a node {'dir', 'first', 'second'}, None if it will not tile.
    """
    if len(panes) == 1:
        return {"pane": panes[0]}

    def cut(axis, size, direction):
        edges = sorted({p["rect"][axis] for p in panes})
        for edge in edges[1:]:
            first = [p for p in panes if p["rect"][axis] < edge]
            second = [p for p in panes if p["rect"][axis] >= edge]
            if not first or not second:
                continue
            if all(p["rect"][axis] + p["rect"][size] <= edge for p in first):
                left, right = split_tree(first), split_tree(second)
                if left and right:
                    return {"dir": direction, "first": left, "second": right}
        return None

    # Try the side-by-side cut first; either one alone identifies the split.
    return cut("x", "width", SPLIT_RIGHT) or cut("y", "height", SPLIT_DOWN)


def prune_tree(node, drop):
    """Drop panes from a split tree, collapsing the splits they leave behind."""
    if node is None:
        return None
    if "pane" in node:
        return None if node["pane"]["pane_id"] in drop else node
    first = prune_tree(node["first"], drop)
    second = prune_tree(node["second"], drop)
    if first is None:
        return second
    if second is None:
        return first
    return {"dir": node["dir"], "first": first, "second": second}


def pane_chain(node):
    """Flatten a split tree into herdr-plus's linear pane list.

    A project builds each pane off the *previous* one, so the tree survives only
    when every split's first side is a single pane. Anything else flattens to
    the nearest chain and is reported as approximate.
    """
    if "pane" in node:
        return [(node["pane"], None)], True

    first, first_exact = pane_chain(node["first"])
    second, second_exact = pane_chain(node["second"])
    head, _ = second[0]
    second = [(head, node["dir"])] + second[1:]
    exact = first_exact and second_exact and "pane" in node["first"]
    return first + second, exact


# -------------------------------------------------------------------- toml --

def toml_string(value):
    out = value.replace("\\", "\\\\").replace('"', '\\"')
    out = out.replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
    return '"%s"' % out


def tilde(path, home):
    if home and (path == home or path.startswith(home + os.sep)):
        return "~" + path[len(home):]
    return path


def shell_path(path, home):
    """Quote a path for a shell command, keeping ~ expandable.

    `cd '~/src'` enters a directory literally named ~, so the tilde stays
    outside the quotes — which is what lets the project open under another home.
    """
    short = tilde(path, home)
    if short == "~":
        return "~"
    if short.startswith("~/"):
        return "~/" + shlex.quote(short[2:])
    return shlex.quote(short)


def slugify(name):
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    return slug or "space"


# ----------------------------------------------------------------- capture --

def resolve_space(requested):
    """Pick the space to save: --space, else the caller's, else the focused one."""
    workspaces = herdr("workspace", "list").get("workspaces", [])
    if not workspaces:
        die("herdr reports no spaces")

    wanted = requested or os.environ.get("HERDR_PLUS_WORKSPACE_ID") \
        or os.environ.get("HERDR_WORKSPACE_ID")
    if wanted:
        for ws in workspaces:
            if ws["workspace_id"] == wanted:
                return ws
        if requested:
            # Allow --space to name a space the way the sidebar labels it.
            matches = [w for w in workspaces if w.get("label") == requested]
            if len(matches) == 1:
                return matches[0]
            if len(matches) > 1:
                die("more than one space is labeled %r; use its id" % requested)
            die("no space %r (have: %s)" % (
                requested, ", ".join("%s (%s)" % (w["workspace_id"], w.get("label", "")) for w in workspaces)))

    for ws in workspaces:
        if ws.get("focused"):
            return ws
    return workspaces[0]


def tab_name(tab, panes, commands):
    """A tab needs a name; herdr only has one when the user set one.

    An unnamed tab reports its display number, so fall back to its contents.
    """
    label = (tab.get("label") or "").strip()
    if label and not label.isdigit():
        return label
    for pane in panes:
        if pane.get("agent"):
            return pane["agent"]
    for command in commands:
        if command:
            return os.path.basename(shlex.split(command)[0])
    return "terminal"


def capture(space, args):
    ws_id = space["workspace_id"]
    ancestors = ancestor_pids()
    roots = plugin_roots()
    home = os.path.expanduser("~")

    tabs = herdr("tab", "list", "--workspace", ws_id).get("tabs", [])
    if not tabs:
        die("space %s has no tabs" % ws_id)

    all_panes = herdr("pane", "list", "--workspace", ws_id).get("panes", [])
    by_tab = {}
    for pane in all_panes:
        by_tab.setdefault(pane["tab_id"], []).append(pane)

    captured = []
    for tab in tabs:
        panes = by_tab.get(tab["tab_id"], [])
        if not panes:
            warn("tab %s has no panes; skipped" % tab["tab_id"])
            continue

        processes = {p["pane_id"]: pane_process(p["pane_id"]) for p in panes}
        transient = {p["pane_id"] for p in panes
                     if is_plugin_pane(p, processes[p["pane_id"]], roots)}
        keep = [p for p in panes if p["pane_id"] not in transient]
        if not keep:
            # Nothing but plugin UI; not something a template should rebuild.
            continue

        layout = herdr("pane", "layout", "--pane", panes[0]["pane_id"]).get("layout", {})
        geometry = {p["pane_id"]: p for p in layout.get("panes", [])}
        placed = [geometry[p["pane_id"]] for p in panes if p["pane_id"] in geometry]

        if len(placed) != len(panes):
            warn("tab %s: layout is missing pane geometry; keeping pane order" % tab["tab_id"])
            chain = [(p["pane_id"], None if i == 0 else SPLIT_DOWN)
                     for i, p in enumerate(keep)]
        else:
            # Built from every pane so the geometry still tiles, then pruned.
            tree = prune_tree(split_tree(placed), transient)
            if tree is None:
                warn("tab %s: could not read the split layout; stacking panes" % tab["tab_id"])
                chain = [(p["pane_id"], None if i == 0 else SPLIT_DOWN)
                         for i, p in enumerate(keep)]
            else:
                ordered, exact = pane_chain(tree)
                if not exact:
                    warn("tab %s: nested splits flattened — herdr-plus builds each pane "
                         "off the previous one, so the rebuilt layout is close, not identical"
                         % tab["tab_id"])
                chain = [(p["pane_id"], d) for p, d in ordered]

        for split in layout.get("splits", []):
            ratio = split.get("ratio", 0.5)
            if abs(ratio - 0.5) > 0.05:
                warn("tab %s: split ratio %.2f is not part of the project format; "
                     "panes rebuild evenly" % (tab["tab_id"], ratio))
                break

        info = {p["pane_id"]: p for p in panes}
        entries = []
        for pane_id, split in chain:
            pane = info[pane_id]
            command = pane_command(processes[pane_id], bool(pane.get("agent")), ancestors)
            entries.append({
                "command": command,
                "split": split,
                "label": (pane.get("label") or "").strip(),
                "cwd": pane.get("cwd") or "",
            })

        if len(entries) > MAX_PANES_PER_TAB:
            warn("tab %s has %d panes; herdr-plus allows %d, dropping the last %d"
                 % (tab["tab_id"], len(entries), MAX_PANES_PER_TAB,
                    len(entries) - MAX_PANES_PER_TAB))
            entries = entries[:MAX_PANES_PER_TAB]

        captured.append({
            "name": tab_name(tab, keep, [e["command"] for e in entries]),
            "panes": entries,
        })

    if not captured:
        die("space %s has nothing to save" % ws_id)

    working_dir = args.working_dir or captured[0]["panes"][0]["cwd"] or home

    # herdr-plus has no per-pane cwd, only one working_dir. It types a pane's
    # command into that pane's shell, so a `cd` prefix stands in for one.
    if not args.no_cd:
        for tab in captured:
            for entry in tab["panes"]:
                cwd = entry["cwd"]
                if not cwd or cwd == working_dir:
                    continue
                prefix = "cd %s" % shell_path(cwd, home)
                entry["command"] = ("%s && %s" % (prefix, entry["command"])
                                    if entry["command"] else prefix)

    return {
        "name": args.name or space.get("label") or ws_id,
        "description": args.description,
        "group": args.group,
        "working_dir": tilde(working_dir, home),
        "tabs": captured,
        "source": "%s (%s)" % (space.get("label") or ws_id, ws_id),
    }


def render(project):
    lines = [
        "# herdr-plus project saved from herdr space %s." % project["source"],
        "# Written by %s — a plain template, edit it freely." % PROG,
        "",
        "name = %s" % toml_string(project["name"]),
    ]
    if project["description"]:
        lines.append("description = %s" % toml_string(project["description"]))
    if project["group"]:
        lines.append("group = %s" % toml_string(project["group"]))
    lines.append("working_dir = %s" % toml_string(project["working_dir"]))

    for tab in project["tabs"]:
        panes = tab["panes"]
        lines += ["", "[[tabs]]", "name = %s" % toml_string(tab["name"])]

        # Setting both the shorthand and [[tabs.panes]] is a load-time error
        # in herdr-plus.
        if len(panes) == 1:
            pane = panes[0]
            if pane["label"]:
                # A tab has no label field, so a labelled lone pane still needs
                # its own table.
                lines += ["", "[[tabs.panes]]", "label = %s" % toml_string(pane["label"])]
                if pane["command"]:
                    lines.append("command = %s" % toml_string(pane["command"]))
            elif pane["command"]:
                lines.append("command = %s" % toml_string(pane["command"]))
            else:
                lines.append("# no command — just an empty shell")
            continue

        for i, pane in enumerate(panes):
            lines += ["", "[[tabs.panes]]"]
            if pane["label"]:
                lines.append("label = %s" % toml_string(pane["label"]))
            if pane["command"]:
                lines.append("command = %s" % toml_string(pane["command"]))
            elif not pane["label"]:
                lines.append("# no command — just an empty shell")
            if i > 0:
                lines.append("split = %s" % toml_string(pane["split"] or SPLIT_DOWN))

    return "\n".join(lines) + "\n"


def check(text, path):
    """Parse what we just produced: herdr-plus fails the *whole* projects load
    on one malformed file, taking the user's other projects down with it.
    """
    try:
        import tomllib
    except ImportError:
        return
    try:
        tomllib.loads(text)
    except tomllib.TOMLDecodeError as exc:
        die("generated TOML for %s is invalid (%s) — please report this" % (path, exc))


# ------------------------------------------------------------- subcommands --

def cmd_save(args):
    space = resolve_space(args.space)
    project = capture(space, args)
    text = render(project)

    if args.stdout:
        check(text, "<stdout>")
        sys.stdout.write(text)
        return

    tabs = ", ".join("%s%s" % (t["name"], " x%d" % len(t["panes"]) if len(t["panes"]) > 1 else "")
                     for t in project["tabs"])

    if args.out:
        path = os.path.expanduser(args.out)
        replacing = os.path.exists(path)
        if replacing and not args.force:
            die("%s already exists (use --force to overwrite)" % path)
    else:
        directory = projects_dir(args.projects_dir)
        # herdr-plus identifies a project by name, so the name is what has to
        # be unique — two files claiming one make `open <name>` a coin toss.
        clashes = [p for p in load_projects(directory)
                   if (p[1] or "").lower() == project["name"].strip().lower()]
        if clashes and not args.force:
            die("a project named %r already exists (%s) — choose another name, or "
                'overwrite it with --force (the "Plus: save project" action)'
                % (project["name"], os.path.basename(clashes[0][0])))
        if len(clashes) > 1:
            warn("%d files are named %r; overwriting %s and leaving the rest"
                 % (len(clashes), project["name"], os.path.basename(clashes[0][0])))
        replacing = bool(clashes)
        path = clashes[0][0] if clashes else free_path(directory, slugify(project["name"]))

    check(text, path)

    try:
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w") as handle:
            handle.write(text)
    except OSError as exc:
        die("could not write %s: %s" % (path, exc))

    verb = "overwrote" if replacing else "saved"
    print("%s %r -> %s" % (verb, project["name"], path))
    print("  %s" % tabs)
    notify("Herdr Plus: project %s" % ("overwritten" if replacing else "saved"),
           "%s — %s" % (project["name"], tabs))


def cmd_list(args):
    directory = projects_dir(args.projects_dir)
    projects = load_projects(directory)
    if not projects:
        print("no saved projects in %s" % directory)
        return
    width = max(len(p[1] or "?") for p in projects)
    for path, name in projects:
        print("  %-*s  %s" % (width, name or "(unnamed)", os.path.basename(path)))


def cmd_delete(args):
    directory = projects_dir(args.projects_dir)
    projects = load_projects(directory)
    if not projects:
        die("no saved projects in %s" % directory)

    if args.pick or not args.name:
        if not os.path.exists("/dev/tty"):
            die("--pick needs a terminal; pass a project name instead")
        try:
            chosen = pick_project(projects, "Delete a Herdr Plus project")
        except (OSError, ImportError) as exc:
            die("could not open the picker (%s); pass a project name instead" % exc)
        if chosen is None:
            print("cancelled")
            return
        matches = [chosen]
    else:
        # An empty name prefix-matches everything.
        if not args.name.strip():
            die("name a project to delete (saved: %s)" % describe(projects))

        matches = match_projects(projects, args.name)
        if not matches:
            die("no project matching %r (have: %s)" % (args.name, describe(projects)))
        if len(matches) > 1:
            die("%r matches more than one project (%s) — use the full name"
                % (args.name, describe(matches)))

    path, name = matches[0]
    try:
        os.remove(path)
    except OSError as exc:
        die("could not delete %s: %s" % (path, exc))

    label = name or os.path.basename(path)
    print("deleted %r (%s)" % (label, path))
    notify("Herdr Plus: project deleted", "%s — %s" % (label, os.path.basename(path)))


# ------------------------------------------------------------------- git ----

def git(repo, *args):
    """Run git in `repo`. Returns (returncode, stdout, stderr), never dies.

    An unmerged branch and a missing repository both exit non-zero here, and
    only one is worth stopping for, so callers judge rather than this.
    """
    try:
        proc = subprocess.run(
            ("git",) + args, cwd=repo,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
    except OSError as exc:
        return 1, "", str(exc)
    return (proc.returncode,
            proc.stdout.decode("utf-8", "replace").strip(),
            proc.stderr.decode("utf-8", "replace").strip())


def repo_root(path):
    code, out, _ = git(path, "rev-parse", "--show-toplevel")
    if code != 0 or not out:
        die("not a git repository: %s" % path)
    return out


def hook_for(repo, name):
    """The hook script this repo would actually run, or None.

    A relative core.hooksPath resolves against the working tree, so a worktree
    runs its own copy of the hooks rather than the primary checkout's.
    """
    code, configured, _ = git(repo, "config", "--get", "core.hooksPath")
    hooks_dir = configured if code == 0 and configured else ".git/hooks"
    if not os.path.isabs(hooks_dir):
        hooks_dir = os.path.join(repo, hooks_dir)
    path = os.path.join(hooks_dir, name)
    return path if os.access(path, os.X_OK) else None


# -------------------------------------------------------------- conventions --

def convention_evidence(repo):
    """What a caller needs to pick a branch name this repo will accept.

    Evidence, not rules: the repo's own history and hooks are the authority.
    """
    _, subjects, _ = git(repo, "log", "--format=%s", "-n", "15")
    _, branches, _ = git(
        repo, "for-each-ref", "--format=%(refname:short)",
        "--sort=-committerdate", "--count=15", "refs/heads", "refs/remotes")

    hooks = {}
    for name in ("pre-commit", "commit-msg", "pre-push", "prepare-commit-msg"):
        found = hook_for(repo, name)
        if found:
            hooks[name] = found

    docs = [
        name for name in (
            "CONTRIBUTING.md", "AGENTS.md", "CLAUDE.md", "CONVENTIONS.md",
            os.path.join(".github", "PULL_REQUEST_TEMPLATE.md"),
        )
        if os.path.exists(os.path.join(repo, name))
    ]

    return {
        "repo": repo,
        "commit_subjects": [s for s in subjects.splitlines() if s],
        "branches": [b for b in branches.splitlines() if b],
        "hooks": hooks,
        "convention_docs": docs,
    }


def cmd_conventions(args):
    repo = repo_root(os.path.abspath(os.path.expanduser(args.repo or os.getcwd())))
    evidence = convention_evidence(repo)

    if args.json:
        print(json.dumps(evidence, indent=2, sort_keys=True))
        return

    print("repo: %s" % evidence["repo"])
    print("")
    print("recent commit subjects:")
    for subject in evidence["commit_subjects"]:
        print("  %s" % subject)
    print("")
    print("recent branches:")
    for branch in evidence["branches"]:
        print("  %s" % branch)
    print("")
    if evidence["hooks"]:
        print("hooks that will run (these are the authority, not the list above):")
        for name in sorted(evidence["hooks"]):
            print("  %-18s %s" % (name, evidence["hooks"][name]))
    else:
        print("hooks: none installed — nothing here enforces a naming convention")
    if evidence["convention_docs"]:
        print("")
        print("worth reading: %s" % ", ".join(evidence["convention_docs"]))


# ----------------------------------------------------------------- dispatch --

# A herdr agent alias has to match this and be unique among *live* agents.
AGENT_NAME_RE = re.compile(r"^[a-z][a-z0-9_-]*$")

DEFAULT_TASK_FILE = "TASK.md"


def agent_alias(branch, taken):
    """A herdr agent name derived from the branch, distinct from the live ones."""
    base = re.sub(r"[^a-z0-9]+", "-", branch.lower()).strip("-") or "agent"
    if not base[0].isalpha():
        base = "a" + base
    name = base[:40]
    n = 2
    while name in taken:
        name = "%s-%d" % (base[:36], n)
        n += 1
    return name


def live_agent_names():
    return set(a.get("name") or a.get("agent_name") or ""
               for a in herdr("agent", "list").get("agents", []))


def start_agent(alias, kind, pane_id, timeout_ms):
    """Start the agent, waiting out a pane that is not a shell prompt yet.

    `agent start` refuses with agent_pane_busy until the new pane's shell
    reaches its prompt. Its own --timeout does not cover that: it waits for the
    agent to become ready once launched. Retrying the real call rather than
    polling something adjacent keeps herdr the only judge of "available shell".
    """
    deadline = time.monotonic() + max(timeout_ms, 1000) / 1000.0
    while True:
        result, err = herdr_quiet(
            "agent", "start", alias, "--kind", kind,
            "--pane", pane_id, "--timeout", str(timeout_ms))
        if result or "agent_pane_busy" not in err:
            return result, err
        if time.monotonic() >= deadline:
            return {}, err + " — the pane never reached a shell prompt"
        time.sleep(0.5)


def probe_branch(checkout, branch):
    """Ask the repo's own pre-commit whether it will accept this branch name.

    Nothing is staged or committed; the hook is run for its opinion.
    `worktree create` makes no commit, so without this a refusal lands at the
    agent's first commit, deep into its session.

    Advisory: a hook that lints or tests may fail for unrelated reasons, so the
    output goes back verbatim and the caller decides. --no-probe skips it.
    """
    hook = hook_for(checkout, "pre-commit")
    if hook is None:
        return True, "no pre-commit hook in %s" % checkout

    try:
        proc = subprocess.run(
            (hook,), cwd=checkout,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        )
    except OSError as exc:
        return True, "could not run %s: %s" % (hook, exc)

    output = proc.stdout.decode("utf-8", "replace").strip()
    return proc.returncode == 0, output


def teardown(workspace_id, repo, branch, checkout):
    """Undo a dispatch that failed after it had already built something.

    Quiet about its own failures: it runs while a different error is being
    reported, and must not replace the message explaining what went wrong.
    """
    if workspace_id:
        herdr_quiet("worktree", "remove", "--workspace", workspace_id)
        # Removing the worktree does not always take the workspace with it,
        # and one left pointing at a deleted checkout cannot be reopened.
        herdr_quiet("workspace", "close", workspace_id)
    if checkout and os.path.isdir(checkout):
        git(repo, "worktree", "remove", "--force", checkout)
    git(repo, "worktree", "prune")
    if branch:
        git(repo, "branch", "-D", branch)


def herdr_quiet(*args):
    """herdr(), for calls whose failure is not worth dying over.

    Returns (result, error). A failure and a success with nothing to say both
    leave an empty result, so the error half carries herdr's own sentence.
    """
    try:
        proc = subprocess.run(
            ("herdr",) + args, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as exc:
        return {}, str(exc)

    # herdr answers on stdout when it succeeds and stderr when it does not,
    # both as JSON, so the body is worth parsing wherever it arrives.
    for stream in (proc.stdout, proc.stderr):
        text = stream.decode("utf-8", "replace").strip()
        if not text:
            continue
        try:
            payload = json.loads(text)
        except ValueError:
            continue
        if "error" in payload:
            e = payload["error"]
            return {}, "%s (%s)" % (e.get("message", "failed"), e.get("code", "?"))
        if "result" in payload:
            return payload["result"], ""

    text = proc.stderr.decode("utf-8", "replace").strip() \
        or proc.stdout.decode("utf-8", "replace").strip()
    return {}, text[:400] or "no output"


def fail(args, stage, message, detail=""):
    """Report a dispatch failure in a form a caller can act on.

    `stage` and `detail` are for the orchestrator picking branch names: a probe
    refusal carries the hook's own words, which usually name the convention.
    """
    if args.json:
        print(json.dumps({
            "ok": False, "stage": stage, "branch": args.branch,
            "message": message, "detail": detail,
        }, indent=2, sort_keys=True))
    else:
        sys.stderr.write("%s: %s: %s\n" % (PROG, stage, message))
        if detail:
            sys.stderr.write("\n%s\n" % detail)
    notify(FAIL_TITLE, message)
    sys.exit(1)


def task_document(args, repo, checkout, branch, workspace_id, pane_id):
    """The task, plus the facts about where it is being carried out.

    An agent dropped into a fresh worktree cannot tell it is in one, and reasons
    about it as the repository — which is how a task written in the primary
    checkout ends up asking for something only that checkout can do.

    Facts, not instructions: what to do about them belongs in the task.
    """
    if args.no_context:
        return args.task.rstrip("\n") + "\n"

    return (
        "%s\n"
        "\n"
        "---\n"
        "\n"
        "## Where this is running\n"
        "\n"
        "Written by `%s dispatch`. You did not choose this checkout and it is\n"
        "not the one the task was written in.\n"
        "\n"
        "- This directory is a **linked git worktree**: `%s`\n"
        "- The primary checkout is elsewhere: `%s`\n"
        "- Branch `%s`, created from `%s`\n"
        "- herdr workspace `%s`, pane `%s`\n"
        "\n"
        "A worktree shares its history with the primary checkout and nothing\n"
        "else. Tooling that reaches outside the repository — installers, things\n"
        "that link or copy files into a live configuration — may refuse to run\n"
        "here, and refusing is usually the correct behaviour rather than a fault\n"
        "to work around. If the task asks for something that only the primary\n"
        "checkout can do, say so in the pull request instead of forcing it.\n"
        % (args.task.rstrip("\n"), PROG, checkout, repo, branch, args.base,
           workspace_id, pane_id)
    )


def cmd_dispatch(args):
    repo = repo_root(os.path.abspath(os.path.expanduser(args.repo or os.getcwd())))
    branch = args.branch.strip()

    if not branch or branch.startswith("-"):
        fail(args, "branch", "not a usable branch name: %r" % args.branch)

    code, _, _ = git(repo, "rev-parse", "--verify", "--quiet", "refs/heads/" + branch)
    if code == 0:
        fail(args, "branch", "branch %s already exists" % branch,
             "Pick another name, or check out the existing branch by hand.")

    created = herdr("worktree", "create",
                    "--cwd", repo, "--branch", branch, "--base", args.base,
                    "--label", args.label or branch,
                    "--focus" if args.focus else "--no-focus")

    workspace_id = (created.get("workspace") or {}).get("workspace_id")
    pane_id = (created.get("root_pane") or {}).get("pane_id")
    checkout = ((created.get("workspace") or {}).get("worktree") or {}).get("checkout_path") \
        or (created.get("root_pane") or {}).get("cwd")

    if not (workspace_id and pane_id and checkout):
        teardown(workspace_id, repo, branch, checkout)
        fail(args, "worktree", "herdr did not report a workspace, pane and checkout")

    if not args.no_probe:
        ok, output = probe_branch(checkout, branch)
        if not ok:
            teardown(workspace_id, repo, branch, checkout)
            fail(args, "probe",
                 "the repo's pre-commit hook refused branch %s" % branch, output)

    task_path = os.path.join(checkout, args.task_file)
    try:
        with open(task_path, "w") as handle:
            handle.write(task_document(args, repo, checkout, branch,
                                       workspace_id, pane_id))
    except OSError as exc:
        teardown(workspace_id, repo, branch, checkout)
        fail(args, "task", "could not write %s: %s" % (task_path, exc))

    alias = args.agent_name or agent_alias(branch, live_agent_names())
    if not AGENT_NAME_RE.match(alias):
        teardown(workspace_id, repo, branch, checkout)
        fail(args, "agent", "not a usable agent name: %r" % alias)

    start, err = start_agent(alias, args.kind, pane_id, args.agent_timeout)
    if not start:
        teardown(workspace_id, repo, branch, checkout)
        fail(args, "agent", "%s did not come up in the new pane" % args.kind,
             err or "herdr agent start said nothing. Try `herdr agent explain`.")

    prompt = args.prompt or (
        "Read %s in the repository root and start on it." % args.task_file)

    # No teardown past this point: the agent is up, and throwing the worktree
    # away would take its session with it. A failed prompt is retried by hand.
    submitted, prompt_err = herdr_quiet(
        "agent", "prompt", alias, prompt, "--wait",
        "--until", "working", "--timeout", str(args.prompt_timeout))

    result = {
        "ok": True,
        "branch": branch,
        "base": args.base,
        "checkout": checkout,
        "workspace": workspace_id,
        "pane": pane_id,
        "agent": alias,
        "kind": args.kind,
        "task_file": task_path,
        "prompted": bool(submitted),
        "prompt_error": prompt_err,
    }

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print("dispatched %s to %s (%s)" % (branch, alias, args.kind))
        print("  checkout   %s" % checkout)
        print("  workspace  %s   pane %s" % (workspace_id, pane_id))
        # A herdr restart keeps the pane and its process but forgets the
        # alias, after which `agent prompt <name>` answers agent_not_found.
        print("  reach it   herdr agent prompt %s ...   (or %s, which survives "
              "a herdr restart)" % (alias, pane_id))
        print("  task       %s" % task_path)
        if not submitted:
            print("  ! the prompt did not land: %s" % (prompt_err or "no reason given"))
            print("    submit it with `herdr agent prompt %s ...`" % alias)

    notify("Herdr Bellwethr: dispatched", "%s → %s" % (branch, alias))


# --------------------------------------------------------------------- reap --

def worktree_entries(repo):
    """This repo's linked worktrees, as (path, branch) — never the primary one."""
    _, out, _ = git(repo, "worktree", "list", "--porcelain")
    entries, current = [], {}
    for line in out.splitlines() + [""]:
        if not line:
            if current.get("worktree"):
                entries.append(current)
            current = {}
            continue
        key, _, value = line.partition(" ")
        current[key] = value

    primary = os.path.realpath(repo)
    out = []
    for entry in entries:
        path = os.path.realpath(entry.get("worktree", ""))
        if not path or path == primary:
            continue
        branch = entry.get("branch", "")
        out.append((path, branch[len("refs/heads/"):] if branch.startswith("refs/heads/") else ""))
    return out


# Reasons that mean the work reached somewhere other than the base branch, so
# a `git branch -d` refusal is git being literal rather than git being right.
LANDED_ELSEWHERE = (
    "its upstream branch is gone",
    "its commits are on another remote branch",
)


def is_dirty(path, task_file):
    """Uncommitted work, ignoring the task file dispatch wrote.

    Nothing ever commits that file, so without this every dispatched worktree
    looks mid-edit forever.
    """
    code, out, _ = git(path, "status", "--porcelain")
    if code != 0:
        return None
    for line in out.splitlines():
        if line[3:].strip() == task_file and line.startswith("??"):
            continue
        if line.strip():
            return True
    return False


def landed_on_another_remote_branch(repo, branch):
    """Whether this branch's commits turned up on some *other* remote branch.

    Pushing is not landing, and `--contains` finds the branch's own upstream
    first of all — so that ref is excluded, by configured upstream where there
    is one and by name for a branch pushed without tracking.
    """
    code, remotes, _ = git(repo, "branch", "--remotes", "--contains", branch)
    if code != 0 or not remotes:
        return False

    _, upstream, _ = git(repo, "rev-parse", "--abbrev-ref",
                         "%s@{upstream}" % branch)
    upstream = upstream.strip()

    for line in remotes.splitlines():
        ref = line.strip().lstrip("* ").strip()
        if not ref or ref.startswith("origin/HEAD"):
            continue
        if ref == upstream or ref.endswith("/" + branch):
            continue
        return True
    return False


def reap_reason(repo, path, branch, base, workspaces, task_file):
    """Why this worktree is or is not finished with, as (removable, reason)."""
    if not branch:
        return False, "detached HEAD — nothing to judge it by"
    if branch == base:
        return False, "is the base branch"

    if not os.path.isdir(path):
        return True, "checkout is gone"

    dirty = is_dirty(path, task_file)
    if dirty is None:
        return False, "could not read its status"
    if dirty:
        return False, "has uncommitted changes"

    # A branch at the base commit is trivially an ancestor of it, so every test
    # below would call an agent still reading its task "merged". Ask first.
    code, ahead, _ = git(repo, "rev-list", "--count", "%s..%s" % (base, branch))
    if code == 0 and ahead.strip() == "0":
        return False, "no commits of its own yet"

    code, unpushed, _ = git(path, "log", "--oneline", "@{upstream}..HEAD")
    upstream_gone = code != 0
    if not upstream_gone and unpushed:
        return False, "has commits that are not pushed"

    state = workspaces.get(os.path.realpath(path))
    if state in ("working", "blocked"):
        # blocked is an agent waiting on somebody — a conversation in
        # progress. idle is not, and is exactly what this clears up.
        return False, "an agent is %s in it" % state

    code, _, _ = git(repo, "merge-base", "--is-ancestor", branch, base)
    if code == 0:
        return True, "merged into %s" % base

    if landed_on_another_remote_branch(repo, branch):
        return True, "its commits are on another remote branch"

    if upstream_gone:
        code, tracked, _ = git(repo, "config", "--get", "branch.%s.remote" % branch)
        if code == 0 and tracked:
            return True, "its upstream branch is gone"

    return False, "not merged into %s and not on another remote branch" % base


def cmd_reap(args):
    repo = repo_root(os.path.abspath(os.path.expanduser(args.repo or os.getcwd())))

    if not args.no_fetch:
        git(repo, "fetch", "--prune", "--quiet")

    # Which checkout a workspace is sitting in, so a busy agent is not evicted.
    workspaces = {}
    panes = herdr_quiet("pane", "list")[0].get("panes", [])
    states = {w.get("workspace_id"): w.get("agent_status")
              for w in herdr_quiet("workspace", "list")[0].get("workspaces", [])}
    for pane in panes:
        cwd = pane.get("cwd")
        if cwd:
            workspaces[os.path.realpath(cwd)] = states.get(pane.get("workspace_id"))

    workspace_of = {}
    for pane in panes:
        cwd = pane.get("cwd")
        if cwd:
            workspace_of.setdefault(os.path.realpath(cwd), pane.get("workspace_id"))

    here = os.path.realpath(os.getcwd())
    removable, kept = [], []

    for path, branch in worktree_entries(repo):
        if here == path or here.startswith(path + os.sep):
            kept.append((path, branch, "you are in it"))
            continue
        ok, reason = reap_reason(repo, path, branch, args.base, workspaces, args.task_file)
        (removable if ok else kept).append((path, branch, reason))

    if args.json:
        print(json.dumps({
            "repo": repo,
            "removable": [{"path": p, "branch": b, "reason": r} for p, b, r in removable],
            "kept": [{"path": p, "branch": b, "reason": r} for p, b, r in kept],
            "removed": bool(args.remove),
        }, indent=2, sort_keys=True))
    else:
        for path, branch, reason in removable:
            print("%s %s — %s" % ("removing" if args.remove else "would remove",
                                  branch or path, reason))
        for path, branch, reason in kept:
            print("  keeping  %s — %s" % (branch or path, reason))
        if not args.remove and removable:
            print("")
            print("nothing was removed. Pass --remove to act on the list above.")

    if not args.remove:
        return

    task_file = args.task_file
    for path, branch, reason in removable:
        workspace_id = workspace_of.get(path)
        if workspace_id:
            herdr_quiet("worktree", "remove", "--workspace", workspace_id)
            herdr_quiet("workspace", "close", workspace_id)
        if os.path.isdir(path):
            code, _, err = git(repo, "worktree", "remove", path)
            if code != 0:
                # git refuses a worktree holding anything untracked, and every
                # dispatched one holds the task file. Re-check rather than trust
                # reap_reason, whose decision predates everything above.
                if is_dirty(path, task_file) is False:
                    code, _, err = git(repo, "worktree", "remove", "--force", path)
                if code != 0:
                    warn("kept %s: %s" % (path, err.splitlines()[0] if err else "refused"))
                    continue
        git(repo, "worktree", "prune")
        # -d, never -D by default: whether commits would be lost is the one
        # judgement worth deferring to git for.
        code, _, err = git(repo, "branch", "-d", branch)
        if code == 0:
            continue

        # A squash merge leaves the branch's commits nowhere in the base, so
        # git calls it unmerged however thoroughly the work landed. Hence
        # --delete-branch — but never on the "merged into base" reading alone.
        landed = reason in LANDED_ELSEWHERE
        if args.delete_branch and landed:
            code, _, err = git(repo, "branch", "-D", branch)
            if code == 0:
                print("  deleted branch %s (%s)" % (branch, reason))
                continue

        warn("kept branch %s: %s%s" % (
            branch,
            err.splitlines()[0] if err else "refused",
            "" if args.delete_branch or not landed
            else " — pass --delete-branch to remove it anyway"))


# -------------------------------------------------------------------- main --

def main():
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Save herdr-plus projects, and dispatch agents into worktrees.",
    )
    subparsers = parser.add_subparsers(dest="command")

    def shared(sub):
        sub.add_argument("--projects-dir", metavar="DIR",
                         help="projects directory (default: herdr-plus's own)")
        sub.add_argument("--notify", action="store_true",
                         help="report the result as a herdr notification (for keybinds "
                              "and quick actions, which have no terminal to print to)")

    save = subparsers.add_parser(
        "save", help="save a space as a project",
        description="Save a live herdr space as a herdr-plus project template.",
        epilog="With no options it saves the space you are in, named after it. Reopen it "
               "from the projects browser (prefix+shift+o) or with `herdr-plus open <name>`.")
    save.add_argument("name", nargs="?", help="project name (default: the space's label)")
    save.add_argument("--space", metavar="ID", help="space to save, by id or label "
                      "(default: the current space, else the focused one)")
    save.add_argument("--group", metavar="TEXT", help="group heading in the projects browser")
    save.add_argument("--description", metavar="TEXT", help="project description")
    save.add_argument("--working-dir", metavar="PATH",
                      help="project working_dir (default: the first pane's cwd)")
    save.add_argument("--out", metavar="FILE", help="write here instead of the projects dir")
    save.add_argument("--stdout", action="store_true", help="print the TOML, write nothing")
    save.add_argument("--force", action="store_true",
                      help="overwrite the project that already has this name")
    save.add_argument("--no-cd", action="store_true",
                      help="skip the `cd` prefix for panes outside working_dir")
    shared(save)
    save.set_defaults(func=cmd_save)

    listing = subparsers.add_parser("list", help="list saved projects",
                                    description="List the saved herdr-plus projects.")
    shared(listing)
    listing.set_defaults(func=cmd_list)

    delete = subparsers.add_parser(
        "delete", help="delete a saved project",
        description="Delete a saved herdr-plus project by name.",
        epilog="The name is matched case-insensitively, exactly or by prefix; a prefix "
               "that matches several projects is refused rather than guessed.")
    delete.add_argument("name", nargs="?", default="",
                        help="project name (or its file name); omit to fuzzy-pick one")
    delete.add_argument("--pick", action="store_true",
                        help="always show the fuzzy picker, ignoring any name given")
    shared(delete)
    delete.set_defaults(func=cmd_delete)

    conventions = subparsers.add_parser(
        "conventions", help="what a repo expects of a branch or commit name",
        description="Report the evidence for naming a branch in a repo.",
        epilog="Evidence, not rules: recent commits and branches, the hooks that will "
               "actually run, and any convention docs. Nothing here has an opinion.")
    conventions.add_argument("--repo", metavar="PATH", help="repository (default: cwd)")
    conventions.add_argument("--json", action="store_true", help="machine-readable")
    shared(conventions)
    conventions.set_defaults(func=cmd_conventions)

    dispatch = subparsers.add_parser(
        "dispatch", help="hand a task to an agent in a fresh worktree",
        description="Create a worktree, start an agent in it, and give it the task.",
        epilog="--branch is required and never derived: which names a repo accepts is "
               "the repo's business, so ask `conventions` first and let the caller "
               "choose. A branch the repo's pre-commit hook rejects is reported with "
               "that hook's own words, and everything created is torn down again. The "
               "agent's name is forgotten if herdr restarts, so hold on to the pane id "
               "it reports — that keeps working.")
    dispatch.add_argument("task", help="the task, written into the worktree for the agent")
    dispatch.add_argument("--branch", required=True, metavar="NAME",
                          help="branch to create (required; nothing here invents one)")
    dispatch.add_argument("--repo", metavar="PATH", help="repository (default: cwd)")
    dispatch.add_argument("--base", metavar="REF", default="main",
                          help="what to branch from (default: main)")
    dispatch.add_argument("--kind", metavar="KIND", default="claude",
                          help="agent kind herdr should start (default: claude)")
    dispatch.add_argument("--agent-name", metavar="NAME",
                          help="agent alias (default: derived from the branch)")
    dispatch.add_argument("--label", metavar="TEXT", help="workspace label (default: the branch)")
    dispatch.add_argument("--task-file", metavar="NAME", default=DEFAULT_TASK_FILE,
                          help="where to write the task (default: %s)" % DEFAULT_TASK_FILE)
    dispatch.add_argument("--prompt", metavar="TEXT",
                          help="what to say to the agent (default: read the task file)")
    dispatch.add_argument("--no-context", action="store_true",
                          help="write the task alone, without the note saying "
                               "which worktree and branch it is running in")
    dispatch.add_argument("--no-probe", action="store_true",
                          help="skip asking the repo's pre-commit about the branch name")
    dispatch.add_argument("--focus", action="store_true", help="focus the new workspace")
    dispatch.add_argument("--agent-timeout", type=int, default=60000, metavar="MS")
    dispatch.add_argument("--prompt-timeout", type=int, default=60000, metavar="MS")
    dispatch.add_argument("--json", action="store_true", help="machine-readable")
    shared(dispatch)
    dispatch.set_defaults(func=cmd_dispatch)

    reap = subparsers.add_parser(
        "reap", help="report worktrees that look finished with",
        description="Find dispatched worktrees whose work has landed.",
        epilog="Reports and removes nothing until --remove. A worktree kept a day too "
               "long costs a directory; one removed a moment too early costs whatever "
               "was in it, so anything uncertain is kept and said out loud.")
    reap.add_argument("--repo", metavar="PATH", help="repository (default: cwd)")
    reap.add_argument("--base", metavar="REF", default="main",
                      help="branch work merges into (default: main)")
    reap.add_argument("--remove", action="store_true", help="actually remove them")
    reap.add_argument("--delete-branch", action="store_true",
                      help="also delete a branch git calls unmerged, when the work "
                           "landed somewhere other than the base (squash merges)")
    reap.add_argument("--task-file", metavar="NAME", default=DEFAULT_TASK_FILE,
                      help="task file dispatch writes, ignored when judging a "
                           "worktree dirty (default: %s)" % DEFAULT_TASK_FILE)
    reap.add_argument("--no-fetch", action="store_true",
                      help="skip `git fetch --prune`, use cached remote refs")
    reap.add_argument("--json", action="store_true", help="machine-readable")
    shared(reap)
    reap.set_defaults(func=cmd_reap)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(2)

    global NOTIFY, FAIL_TITLE
    NOTIFY = args.notify
    FAIL_TITLE = "Herdr Bellwethr: %s failed" % args.command

    args.func(args)


if __name__ == "__main__":
    main()
