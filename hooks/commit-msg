#!/bin/sh
#
# commit-msg — hold commit messages to Conventional Commits.
#
#   <type>[(scope)][!]: <subject>
#
#   feat(hooks): refuse a branch name that is not <type>/<slug>
#   fix(dev-link): back up a plain file before replacing it
#   chore!: rename herdr-project to herdr-bellwethr
#
# The prefix is the machine-readable half: it is what a changelog generator and
# a semver bump read, and `!` (or a `BREAKING CHANGE:` footer) is the only part
# of a commit message that can mean a major version on its own.
#
# The body is the half people read, and this hook deliberately does not require
# one — a rule that forces a paragraph produces paragraphs that say nothing. The
# repo's own commits explain why a change was made rather than restating what
# the diff already shows; that is a habit, not something a regex can check.
#
# Left alone on purpose:
#
#   Merge ...        git writes these, and the format is git's to choose
#   Revert "..."     likewise, and the quoted subject already carries a type
#   fixup!/squash!   placeholders that disappear at `rebase --autosquash`
#
# Deliberate exception:
#
#   BELLWETHR_SKIP_CHECKS=1 git commit ...   this commit only
#   git commit --no-verify ...               skip every hook
#
# Local guard, same as the others. GitHub has no ruleset for commit format, so
# unlike the main check this one has no server-side replacement to graduate to —
# it stays after the repo goes public.

if [ -n "$BELLWETHR_SKIP_CHECKS" ]; then
	exit 0
fi

. "$(dirname "$0")/common.sh"

msg_file="$1"

# Everything git will strip before storing: comment lines, and the diff below
# the scissors line that `commit --verbose` appends. Checking the raw file would
# read the diff as a body.
clean=$(sed -e '/^# -\{1,\} >8 -\{1,\}$/,$d' -e '/^#/d' "$msg_file")

subject=$(printf '%s\n' "$clean" | awk 'NF {print; exit}')

if [ -z "$subject" ]; then
	# An empty message aborts the commit on its own; saying so twice helps nobody.
	exit 0
fi

case "$subject" in
"Merge "* | "Revert "* | "fixup!"* | "squash!"*) exit 0 ;;
esac

fail() {
	echo "commit-msg: $1" >&2
	echo >&2
	echo "  subject: $subject" >&2
	echo >&2
	echo "  format:  <type>[(scope)][!]: <subject>" >&2
	echo "  types:   $(printf '%s' "$BELLWETHR_TYPES" | tr '|' ' ')" >&2
	echo "  example: feat(hooks): refuse an off-convention branch name" >&2
	echo >&2
	echo "  git commit --amend                       fix it in place" >&2
	echo "  BELLWETHR_SKIP_CHECKS=1 git commit ...   commit it as written" >&2
	exit 1
}

if ! printf '%s' "$subject" | grep -Eq "^(${BELLWETHR_TYPES})(\([a-z0-9][a-z0-9-]*\))?!?: .+"; then
	fail "subject does not start with a Conventional Commits type."
fi

description=${subject#*: }

# 72 is where git log stops being readable in an 80-column terminal once it has
# added its four-space indent.
if [ "${#subject}" -gt 72 ]; then
	fail "subject is ${#subject} characters; the limit is 72."
fi

case "$description" in
[A-Z]*) fail "description starts with a capital; keep it lowercase." ;;
*.) fail "description ends with a period; drop it." ;;
esac

# A body has to be separated from the subject, or git treats the whole run of
# lines as one paragraph and every tool that shows a subject shows all of it.
subject_line=$(printf '%s\n' "$clean" | awk 'NF {print NR; exit}')
next_line=$(printf '%s\n' "$clean" | sed -n "$((subject_line + 1))p")

if [ -n "$next_line" ]; then
	fail "the line after the subject must be blank."
fi

exit 0
