#!/bin/sh
#
# pre-push — refuse to create an off-convention branch on the remote.
#
# git feeds one line per ref on stdin:
#
#   <local ref> <local sha> <remote ref> <remote sha>
#
# The remote ref is what matters, not the current branch: `git push origin
# feat/x:whatever` puts `whatever` on the remote, and that is the name the pull
# request carries.
#
# main is not checked here. The "main: pull request only" ruleset does it on the
# remote, for every clone — `gh api repos/<owner>/<repo>/rulesets` reads it back.

if [ -n "$BELLWETHR_SKIP_CHECKS" ]; then
	exit 0
fi

. "$(dirname "$0")/common.sh"

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -n "$remote_ref" ] || continue

	case "$remote_ref" in
	refs/heads/*) ;;
	*) continue ;;
	esac

	bellwethr_check_branch "${remote_ref#refs/heads/}" "pre-push" || status=1
done

exit "$status"
