#!/bin/sh
#
# pre-commit — refuse to commit on a branch named off-convention.
#
# The name is checked at commit time, not push time: once a branch is pushed and
# has a pull request, renaming it has to happen on the remote or the PR closes.
#
# main is the ruleset's job now, not this hook's — see hooks/pre-push.

if [ -n "$BELLWETHR_SKIP_CHECKS" ]; then
	exit 0
fi

. "$(dirname "$0")/common.sh"

# Detached HEAD has no branch name to hold to a convention, and rebases and
# bisects run there.
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0

bellwethr_check_branch "$branch" "pre-commit" || exit 1

exit 0
